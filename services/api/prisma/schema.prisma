generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors packages/types' UserRole (§9). A user's account-level role;
// ShopStaff.role uses the same vocabulary for their role at one specific
// shop, since the same person can hold different roles at different shops.
enum UserRole {
  CUSTOMER
  SHOP_OWNER
  SHOP_MANAGER
  SHOP_COUNTER
  ADMIN
  // §46/16.1: added additively. OPERATOR runs the production floor,
  // PRINTER_MANAGER owns the printer fleet, SUPPLIER is a future
  // supplier-portal account -- none existed as a shop-staff role
  // before 16.1, so every existing row is unaffected.
  OPERATOR
  PRINTER_MANAGER
  SUPPLIER
  // 24.1 (QR guest ordering): added additively, same pattern as 16.1 --
  // none existed before, every existing row is unaffected. A SYSTEM user
  // is never a person: it is a shop's synthetic QR-order account
  // (Shop.qrSystemUserId), created lazily by PublicOrdersService so a QR
  // order's non-nullable Order.customerId always has a real User behind
  // it. It holds no permissions, has an unusable password and an
  // undeliverable address, and is hidden from the admin user views.
  SYSTEM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// §52. password_hash is not listed in the PRD's table sketch, but §52
// explicitly defers auth-secret storage to "the selected authentication
// architecture" -- the locked decision (own JWT, argon2id) requires it.
model User {
  id           String     @id @default(uuid())
  role         UserRole
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  phone        String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  shopStaff           ShopStaff[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  documents           Document[]
  orders              Order[]
  notifications       Notification[]
  staffNotifications  StaffNotification[]
  createdPairingCodes AgentPairingCode[]
  refundsActedOn      Refund[]             @relation("RefundActor")
  // 18.9: jobs this user (role OPERATOR) is manually or automatically
  // assigned to run.
  printJobsAsOperator PrintJob[]           @relation("PrintJobOperator")
  // 21.4: reprints this user requested.
  reprintsRequested   PrintJobReprint[]    @relation("PrintJobReprintRequester")
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementActor")
  purchaseOrdersCreated  PurchaseOrder[] @relation("PurchaseOrderCreator")
  purchaseOrdersReceived PurchaseOrder[] @relation("PurchaseOrderReceiver")
  // 24.1: set only on a role SYSTEM user -- the shop it is the QR-order
  // account of (Shop.qrSystemUserId is the owning side).
  qrSystemUserOfShop     Shop?           @relation("ShopQrSystemUser")

  // 23.6: trigram index so ILIKE %term% search is indexed (phase23_search_indexes migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_phone_trgm_idx")
  @@map("users")
}

// Refresh token rotation (1.4): each row is one issued token, identified
// by its hash (never the raw token). family_id links every token in one
// rotation chain; reuse of a revoked token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// §70 recovery flow (1.5): single-use, short-TTL. Identified by its hash,
// like refresh_tokens -- the raw token is never persisted. usedAt makes
// it single-use; a second consumption attempt is rejected.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// §107 -- a customer may never submit an order to a shop not currently
// accepting them.
enum ShopStatus {
  OPEN
  CLOSED
  BUSY
  TEMPORARILY_UNAVAILABLE
  SUSPENDED
}

// §53. `capabilities` mirrors packages/types' `PrinterCapabilities`
// (§18/§49 -- the same shape printers themselves will carry from Phase
// 8.4) as JSONB: {color, duplex, a4, a3}. Null means "not yet declared" --
// 4.3's shop discovery filter treats that as "matches nothing" rather
// than guessing, so an unconfigured shop is never wrongly offered for a
// configuration it might not support.
model Shop {
  id                  String     @id @default(uuid())
  name                String
  address             String
  latitude            Float?
  longitude           Float?
  phone               String?
  status              ShopStatus @default(CLOSED)
  openingHours        Json?      @map("opening_hours")
  capabilities        Json?
  // 19.4: opt-in automatic handoff when a printer becomes unsuitable.
  autoFailoverEnabled Boolean    @default(false) @map("auto_failover_enabled")
  // 20.3 (PRD 28): opt-in paper-availability gate + consumption. Default false.
  inventoryTrackingEnabled Boolean @default(false) @map("inventory_tracking_enabled")
  // 15.4: both default false, so no existing shop's behaviour changes
  // the moment this column exists. qualityCheckEnabled is §68/21.3's
  // per-business QC toggle; multiItemEnabled gates Phase 18's order-
  // item explosion (§64) -- while false, a shop's orders keep taking
  // exactly the one synthetic OrderItem this migration backfills, even
  // after Phase 17/18 ship the machinery to create more than one.
  qualityCheckEnabled Boolean    @default(false) @map("quality_check_enabled")
  multiItemEnabled    Boolean    @default(false) @map("multi_item_enabled")
  // 24.1 (QR guest ordering): the shop's synthetic role SYSTEM User that
  // every QR-placed order's customerId points at (the real guest's name/
  // phone go on a Customer row via customerRecordId, as for a counter
  // order). Nullable and lazily created on the shop's first QR request by
  // PublicOrdersService, so shop creation needs no change and every
  // existing shop is unaffected. SetNull: removing that user never takes
  // the shop with it; the next QR request would provision a fresh one.
  qrSystemUserId      String?    @unique @map("qr_system_user_id")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  qrSystemUser      User?       @relation("ShopQrSystemUser", fields: [qrSystemUserId], references: [id], onDelete: SetNull)
  staff             ShopStaff[]
  staffInvites      ShopStaffInvite[]
  branches          Branch[]
  pricingRules      PricingRule[]
  orders            Order[]
  printers          Printer[]
  printerAgents     PrinterAgent[]
  agentPairingCodes AgentPairingCode[]
  customers         Customer[]
  products          Product[]
  inventoryItems    InventoryItem[]
  inventoryMovements InventoryMovement[]
  inventoryAlerts    InventoryAlert[]
  staffNotifications StaffNotification[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  settings           ShopSettings?
  printerRules       PrinterAutomationRule[]
  plan               ShopPlan?
  paymentProofs      PaymentProof[]

  @@map("shops")
}

// A physical location of a business. Every shop always has at least one (a migration backfilled
// them and a trigger creates the first for each new shop). `isOpen` is the branch's own switch;
// the business-level `Shop.status` stays the master gate over every branch. `openingHours` is
// shown, never enforced. Staff and invites point here (NULL = "All branches"); the composite
// unique (id, shopId) lets other tables reference a branch only within their own business.
model Branch {
  id           String    @id @default(uuid())
  shopId       String    @map("shop_id")
  name         String
  city         String?
  address      String
  phone        String?
  latitude     Float?
  longitude    Float?
  isOpen       Boolean   @default(true) @map("is_open")
  openingHours Json?     @map("opening_hours")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff        ShopStaff[]
  staffInvites ShopStaffInvite[]

  @@unique([shopId, name])
  @@unique([id, shopId])
  @@index([shopId])
  @@map("branches")
}

// §13/17.1: a shop's own named product catalog (e.g. "Business Cards",
// "A4 Handout Booklet") -- distinct from PricingRule, which prices raw
// page/copy/color inputs generically. A Product is a shop-defined,
// named thing a customer or counter staff can pick, carrying its own
// descriptive/tax/requirement metadata; nothing here prices anything
// by itself yet (that's still PricingRule's job, extended in 17.2) --
// wiring a specific OrderItem to a specific Product is explicitly
// deferred to Phase 18 (§64's multi-item explosion), which is why this
// model has no relation to Order/OrderItem at all yet, only to Shop.
// Deliberately no assumption of a 1:1 with any one order: a Product
// outlives any single order and is reused across many.
//
// `printerRequirements` mirrors `Printer.capabilities`'s own
// {color, duplex, a4, a3} JSON shape (§18/§49) rather than inventing a
// new one -- "what this product needs a printer to support" is the
// same vocabulary as "what a printer supports". `paperRequirements`
// mirrors `PrintConfiguration`'s own paperSize/paperType fields
// (15.1/§64) for the same reason -- "what paper this product needs" is
// the same closed vocabulary a print job's own configuration already
// uses, not a freeform new shape.
model Product {
  id                    String   @id @default(uuid())
  shopId                String   @map("shop_id")
  name                  String
  description           String?
  // Free text, not a closed enum -- a shop's own product categories
  // ("Stationery", "Marketing Material", ...) are shop-specific
  // vocabulary, the same reasoning Printer.model/location/
  // connectionType already established for free-text profile fields.
  category              String?
  // e.g. "per page", "per copy", "per item" -- free text for the same
  // reason as category; nothing in this sub-phase's scope prices off
  // this field yet (17.2/17.3 extend PricingRule directly).
  unit                  String?
  // Matches PricingRule's own basis-points convention (17.2) rather
  // than a float percentage -- never floating point for anything
  // money- or rate-adjacent in this schema.
  taxRateBasisPoints    Int?     @map("tax_rate_basis_points")
  printerRequirements   Json?    @map("printer_requirements")
  paperRequirements     Json?    @map("paper_requirements")
  available             Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  // 23.6: trigram index so ILIKE %term% search is indexed (phase23_search_indexes migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm_idx")
  @@index([category(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_category_trgm_idx")
  @@map("products")
}

// 15.5/§33. A shop's OWN customer record -- distinct from `User`
// (self-service accounts, §4.1) the same way `customerRecordId` on
// Order is distinct from `customerId`: this is a walk-in customer a
// counter staff member describes, not someone who ever logged in.
// No email/phone uniqueness constraint on purpose -- two different
// customers can share a phone number (a household, a shared office
// line) and staff need to be able to record that rather than have it
// rejected as a duplicate.
model Customer {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  name      String
  phone     String?
  email     String?
  company   String?
  address   String?
  // §33 "Account status" -- a plain active/inactive flag rather than a
  // new enum for two states, matching ShopStaffStatus's own boolean-
  // shaped ACTIVE/REMOVED pattern in spirit without the ceremony of a
  // second enum type for something this simple.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([shopId])
  // 23.6: trigram index so ILIKE %term% search is indexed (phase23_search_indexes migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_phone_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_email_trgm_idx")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_company_trgm_idx")
  @@map("customers")
}

// §19/§20, Migration 003 (4.2). Versioned, not updated in place: a price
// change inserts a new row with version = previous + 1 rather than
// mutating the old one, which is what makes §20's "existing orders must
// not change when a shop reprices" possible once Phase 5 snapshots
// whichever row was current at order-creation time. The current rule
// for a shop is the row with the highest version -- no separate
// "isActive" flag needed since version order already answers that.
model PricingRule {
  id                         String   @id @default(uuid())
  shopId                     String   @map("shop_id")
  version                    Int
  currency                   String
  pricePerPageMinor          Int      @map("price_per_page_minor")
  colorSurchargePerPageMinor Int      @map("color_surcharge_per_page_minor")
  otherCharges               Json     @map("other_charges")
  minimumChargeMinor         Int      @map("minimum_charge_minor")
  // §14/17.2/17.3: packages/pricing's own PricingRule type additions,
  // persisted here so 17.3's new writer can actually store them. All
  // nullable -- every row created before this migration (including
  // every seed.ts row) has none of these set, which computeQuote()
  // already treats as "no surcharge/no tax configured," its own
  // pre-17.2 behaviour exactly. Json maps are keyed by the closed
  // PaperSize/PaperType/Finishing enums (packages/pricing's own type
  // comment explains why these are real typed columns, not another
  // otherCharges-style freeform entry).
  paperSizeSurchargePerPageMinor  Json? @map("paper_size_surcharge_per_page_minor")
  paperTypeSurchargePerPageMinor  Json? @map("paper_type_surcharge_per_page_minor")
  finishingChargeMinor            Json? @map("finishing_charge_minor")
  taxRateBasisPoints              Int?  @map("tax_rate_basis_points")
  createdAt                  DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, version])
  @@map("pricing_rules")
}

enum ShopStaffStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

// §54. (shop_id, user_id) is unique -- one membership row per person per
// shop; multi-shop staff get one row per shop, each with its own role.
model ShopStaff {
  id        String          @id @default(uuid())
  shopId    String          @map("shop_id")
  userId    String          @map("user_id")
  role      UserRole
  status    ShopStaffStatus @default(ACTIVE)
  // Per-person access: the DIFFERENCE from the role's defaults (granted / taken away).
  // Effective permissions = (role defaults + extra) - removed; owners ignore both.
  extraPermissions   String[] @default([]) @map("extra_permissions")
  removedPermissions String[] @default([]) @map("removed_permissions")
  // The branch this person works at; NULL = "All branches" (owners, and anyone an owner marks so).
  branchId  String?         @map("branch_id")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId, shopId], references: [id, shopId], onDelete: NoAction, onUpdate: NoAction, map: "shop_staff_branch_shop_fkey")

  @@unique([shopId, userId])
  @@index([branchId])
  @@map("shop_staff")
}

// 23.15: a pending invitation for someone with no account yet (or, uniformly, an
// addressee we only know by email). The raw token is emailed and never stored (only its
// hash, like password_reset_tokens); accepting needs BOTH the token (proof of mailbox) and a
// signed-in account whose email equals `email`, so registering an invited address does NOT
// by itself grant anything. One row per (shop, email): re-inviting refreshes it in place.
model ShopStaffInvite {
  id         String    @id @default(uuid())
  shopId     String    @map("shop_id")
  // Lower-cased.
  email      String
  role       UserRole
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String?   @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")
  // Where the invited person will work; NULL = "All branches".
  branchId   String?   @map("branch_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId, shopId], references: [id, shopId], onDelete: NoAction, onUpdate: NoAction, map: "shop_staff_invites_branch_shop_fkey")

  @@unique([shopId, email])
  @@index([email])
  @@map("shop_staff_invites")
}

// §83. Append-only -- rows are never updated or deleted by application
// code. actorId is nullable for system-initiated actions with no human
// actor (e.g. an expiration worker).
model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// §14/§86 processing pipeline states. PENDING_UPLOAD: presigned PUT
// issued (2.5), nothing arrived yet. PROCESSING: 2.7's worker is
// validating/scanning/encrypting the quarantine object. READY: the
// encrypted object lives at storage_key = documents/{id}; encrypted_dek/
// iv/auth_tag/encryption_version are all set. REJECTED: failed
// validation; rejection_reason says which check failed, quarantine
// object was deleted either way (2.7's Done-when). DELETED: retention
// (Phase 11) removed the object; the row is kept for order history
// (7.5) with storage_key/encrypted_dek cleared.
enum DocumentStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
  DELETED
}

// §55, extended with the envelope-encryption fields §62 requires
// (encrypted_dek/iv/auth_tag/encryption_version -- the wrapped DEK from
// 2.2's KeyManagementService and the params 2.3's CryptoService needs to
// decrypt) and storage_key (2.1's quarantine/{id} vs documents/{id}
// layout; persisted explicitly rather than re-derived from id+status,
// so the object's actual current location is never ambiguous).
model Document {
  id                String         @id @default(uuid())
  ownerUserId       String         @map("owner_user_id")
  // 11.5: nullable as of its own migration -- a DELETED document (2.5's
  // own customer-initiated remove(), or 11.5's own retention sweep) has
  // its object genuinely gone from storage, so a non-null value here
  // must always mean "this key is live," never a dangling pointer to
  // something that no longer exists.
  storageKey        String?        @map("storage_key")
  filename          String
  mimeType          String         @map("mime_type")
  sizeBytes         Int            @map("size_bytes")
  pageCount         Int?           @map("page_count")
  checksum          String?
  encryptedDek      Bytes?         @map("encrypted_dek")
  iv                Bytes?
  authTag           Bytes?         @map("auth_tag")
  encryptionVersion Int?           @map("encryption_version")
  // 21.9/21.10: when the printable PDF (storage_key) was derived from an
  // image or DOCX upload, the original is kept encrypted under the same
  // encrypted_dek with its own iv/auth_tag. All three are null for a
  // plain PDF upload. mime_type is the sniffed type of the original.
  originalStorageKey String?       @map("original_storage_key")
  originalIv        Bytes?         @map("original_iv")
  originalAuthTag   Bytes?         @map("original_auth_tag")
  status            DocumentStatus @default(PENDING_UPLOAD)
  rejectionReason   String?        @map("rejection_reason")
  expiresAt         DateTime?      @map("expires_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  owner      User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  orders     Order[]
  orderItems OrderItem[]

  @@index([ownerUserId])
  @@index([status])
  // 23.6: trigram index so ILIKE %term% search is indexed (phase23_search_indexes migration).
  @@index([filename(ops: raw("gin_trgm_ops"))], type: Gin, map: "documents_filename_trgm_idx")
  @@map("documents")
}

// S25/S26, Migration 004 (5.1). payment_status and order_status are
// deliberately separate columns -- S26's own example (payment_status =
// PAID, order_status = PRINT_FAILED) is exactly why: they track two
// genuinely independent lifecycles, and conflating them into one
// column would make that state unrepresentable. Each is independently
// indexed (5.1's own Done-when) since shop/admin views will filter by
// one without caring about the other.
//
// print_configuration and pricing_snapshot are both JSONB, not a set
// of scalar columns mirroring S56's sketch (subtotal/platform_fee/
// total_amount/currency as their own columns) -- pricing_snapshot
// stores the *entire* computed Quote (packages/pricing, 4.1: every
// line item, not just the three totals), which is what S20's "the
// exact price configuration used must be stored with the order" and
// "existing orders must not change" actually need once a shop
// reprices (4.2's versioned pricing_rules) after the order exists.
// Nothing yet needs those totals as independently queryable/sortable
// columns; that can be added later against a real need rather than
// guessed at now.
model Order {
  id                 String        @id @default(uuid())
  publicOrderNumber  String        @unique @map("public_order_number")
  customerId         String        @map("customer_id")
  // 15.5/§33. Deliberately coexists with customerId above, never
  // replaces it: customerId is the self-service User who placed this
  // order through customer-web (non-nullable, unchanged);
  // customerRecordId is a shop's own walk-in customer record (a
  // Customer row, below) that Phase 17's counter-ordering flow will
  // start writing when a shop takes an order at the counter on
  // someone's behalf. Nullable because every order created before
  // Phase 17 -- and every self-service order after it -- has no walk-in
  // customer record at all. This migration only adds the column;
  // OrdersService.create() and every other writer are untouched, per
  // 15.5's own explicit scope (that wiring is Phase 17's job).
  //
  // 17.5 judgment call: for a COUNTER order, `customerId` (still
  // non-nullable -- 15.5 deliberately left it that way, per its own
  // migration comment above) is set to the STAFF MEMBER who created
  // the order, not a synthetic placeholder User. Reasoning: (1) it
  // avoids inventing and maintaining a fake per-shop "walk-in" account
  // with a fabricated email that could collide with a real signup and
  // that would need its own lifecycle; (2) OrderStateMachine's own
  // notification step (order-state-machine.ts) looks up
  // `customer.email` to send order-lifecycle emails -- routing those
  // to the staff member who placed the order on the customer's behalf
  // is a real, working inbox, not a bounce; (3) it keeps `customerId`
  // meaning exactly what it already means everywhere else in this
  // schema -- "the User account this order belongs to for read/
  // ownership purposes" -- which for a counter order genuinely is the
  // staff account that transacted it; the walk-in customer's own
  // actual identity/contact info lives at `customerRecordId` instead,
  // which is what 17.4's Customer record (not this field) is for.
  customerRecordId   String?       @map("customer_record_id")
  shopId             String        @map("shop_id")
  documentId         String        @map("document_id")
  printConfiguration Json          @map("print_configuration")
  pricingSnapshot    Json          @map("pricing_snapshot")
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus        OrderStatus   @default(DRAFT) @map("order_status")
  // 15.4/§68. Plain string, not an enum -- the small, stable set of
  // states (NOT_REQUIRED/PENDING/PASSED/FAILED, roughly) is Phase 21.3's
  // decision to make once the real QC workflow lands; a string column
  // lets this migration exist now without guessing that shape today.
  // Defaults to "NOT_REQUIRED" so every pre-existing and newly-created
  // order is unaffected until a shop turns on qualityCheckEnabled.
  qualityCheckStatus String?       @default("NOT_REQUIRED") @map("quality_check_status")
  // §4.2/§11/17.5. Defaults to CUSTOMER_WEB so every pre-existing order
  // (and every self-service order created after this migration) is
  // unaffected -- COUNTER is only ever written by 17.5's own shop-side
  // order-creation path.
  creationSource     OrderCreationSource @default(CUSTOMER_WEB) @map("creation_source")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  completedAt        DateTime?     @map("completed_at")

  customer       User           @relation(fields: [customerId], references: [id])
  // SetNull, not Cascade -- deleting a shop's walk-in customer record
  // (17.4's job, not this sub-phase's) should never take an order's
  // own history down with it, the same "the order survives" reasoning
  // PrintJob.orderItemId's own onDelete: SetNull already established.
  customerRecord Customer?      @relation(fields: [customerRecordId], references: [id], onDelete: SetNull)
  shop           Shop           @relation(fields: [shopId], references: [id])
  document       Document       @relation(fields: [documentId], references: [id])
  // 21.5: the optional delivery record.
  delivery       OrderDelivery?
  payments       Payment[]
  notifications  Notification[]
  printJobs      PrintJob[]
  refunds        Refund[]
  items          OrderItem[]

  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([customerId])
  @@index([customerRecordId])
  // 23.2: per-shop aggregates (dashboards, reports, search).
  @@index([shopId, orderStatus])
  @@index([shopId, createdAt])
  // 23.6: trigram index so ILIKE %term% search is indexed (phase23_search_indexes migration).
  @@index([publicOrderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_public_order_number_trgm_idx")
  @@map("orders")
}

// §4.2/§11/17.5. CUSTOMER_WEB: self-service, keyed by
// orders.customer_id = the User who placed it through customer-web.
// COUNTER: staff placed it on a customer's behalf via `POST
// /shop/orders`. See Order.customerId's own comment for the judgment
// call on which User backs customerId for a COUNTER order.
// QR (24.1): an unauthenticated guest placed it by scanning the shop's QR
// code (`POST /public/shops/:shopId/orders`). customerId is the shop's
// synthetic SYSTEM user (Shop.qrSystemUserId); the guest is the Customer
// row at customerRecordId.
enum OrderCreationSource {
  CUSTOMER_WEB
  COUNTER
  QR
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum OrderStatus {
  DRAFT
  UPLOADED
  PAYMENT_PENDING
  PAID
  WAITING_FOR_SHOP
  SHOP_ACCEPTED
  QUEUED_FOR_PRINT
  PRINTING
  PRINTED
  READY_FOR_COLLECTION
  COMPLETED
  PAYMENT_FAILED
  SHOP_REJECTED
  PRINT_FAILED
  PRINT_STATUS_UNKNOWN
  CANCELLED
  EXPIRED
  // 18.2: four new order-level statuses, all reachable only via the
  // derived SYNC_JOBS path (aggregate-order-status.ts) except
  // QUALITY_CHECK's own QC_PASS/QC_FAIL/QC_REPRINT exits -- additive,
  // Postgres `ALTER TYPE ... ADD VALUE`, never a rename. PREPARING: an
  // order has been queued but its job(s) are not yet all allocated to
  // a printer (18.6's WAITING/blocked case). ASSIGNED: at least one job
  // has been claimed by an agent but none is actively printing yet.
  // PAUSED: every active job is paused (21.1). QUALITY_CHECK: every
  // required job printed and the shop's qualityCheckEnabled toggle is
  // on (21.3 builds the real staff workflow on top of this).
  PREPARING
  ASSIGNED
  PAUSED
  QUALITY_CHECK
}

// 5.2: PA-YYYYMMDD-NNNNNN order numbers, generated via
// INSERT ... ON CONFLICT (date_key) DO UPDATE ... RETURNING counter --
// atomic under concurrency (no read-then-write race), one row per
// calendar day so the sequence naturally resets daily without a
// separate reset job.
model OrderNumberCounter {
  dateKey String @id @map("date_key")
  counter Int    @default(0)

  @@map("order_number_counters")
}

// 5.3: `Idempotency-Key` header support. Scoped by (key, scope) rather
// than key alone -- a client-generated UUID is only meant to dedupe
// retries of the *same* logical operation; scoping by e.g.
// "POST /v1/orders" keeps two different endpoints from ever colliding
// on a coincidentally-reused key. request_hash is what lets a replay
// with an unexpectedly *different* body be detected and refused (422)
// instead of silently returning a stored response for a different request.
model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String
  scope          String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([key, scope])
  @@map("idempotency_keys")
}

// 7.1/§78. One row per (recipient, event) -- `type` names which of
// the seven §78 domain events this is, `channel` which delivery
// surface carries it (APP always; EMAIL only "where practical", per
// the PRD's own hedge). `sentAt` stays null until the channel's own
// transport actually dispatches it (7.2's queued send, retried on
// failure) -- a row existing is "this notification was decided," not
// "this notification was delivered." `readAt` is customer-web's own
// "mark as read" action on the in-app feed; irrelevant to EMAIL rows,
// which is why it's nullable rather than a second, channel-specific
// table.
model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  orderId   String              @map("order_id")
  type      NotificationType
  channel   NotificationChannel
  payload   Json
  sentAt    DateTime?           @map("sent_at")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  PAYMENT_CONFIRMED
  ORDER_ACCEPTED
  PRINT_STARTED
  PRINT_FAILED
  PRINT_COMPLETED
  READY_FOR_COLLECTION
  ORDER_COMPLETED
  // 11.3/§122: a real gap found while wiring the shop-rejection refund
  // trigger -- SHOP_REJECT had no entry in NOTIFICATION_TYPE_BY_EVENT
  // at all (7.3's own seven §78 events never included it), so
  // rejecting a paid order silently told the customer nothing, despite
  // 11.3's own Done-when explicitly requiring "rejecting a paid order
  // notifies the customer." Every order that ever reaches
  // WAITING_FOR_SHOP (the only state SHOP_REJECT is legal from) has
  // already been paid, so this notification's own text can say
  // "you'll be refunded" unconditionally rather than hedging.
  ORDER_REJECTED
}

// 23.7 (PRD 37/111): the staff half of the notification centre. `notifications` above is
// the CUSTOMER order-status feed (one row per channel, email pipeline attached, always
// tied to an order); operational alerts for a business's staff are a different shape
// (per recipient, per shop, any deep-link target, no email), so they live here instead of
// bending that table -- which keeps every customer-notification query and test untouched.
// One row per recipient so read state is per user. Both FKs cascade: alerts die with the
// shop or the person, so nothing dangles and no cleanup ordering is needed.
model StaffNotification {
  id         String                  @id @default(uuid())
  userId     String                  @map("user_id")
  shopId     String                  @map("shop_id")
  type       StaffNotificationType
  title      String
  body       String
  targetType NotificationTargetType  @map("target_type")
  targetId   String                  @map("target_id")
  // The order the target belongs to, when there is one (a job, say), so a client can offer
  // "open the order" without a lookup. Plain text, not a FK: it is a hint, never a join.
  orderId    String?                 @map("order_id")
  metadata   Json?
  // At most one row per (recipient, key); NULL keys never collide. Low-stock alerts use it
  // so a re-run of the sweep can never notify twice for the same alert.
  dedupeKey  String?                 @map("dedupe_key")
  readAt     DateTime?               @map("read_at")
  createdAt  DateTime                @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([shopId])
  @@map("staff_notifications")
}

enum StaffNotificationType {
  LOW_STOCK
  JOB_BLOCKED
  JOB_HELD_LATE_PRINT
  JOB_FAILED
}

enum NotificationTargetType {
  ORDER
  PRINT_JOB
  PRINTER
  INVENTORY_ITEM
  PURCHASE_ORDER
}

enum NotificationChannel {
  APP
  EMAIL
}

// 6.1/§57. `amountMinor` (not `amount`) matches this codebase's
// existing integer-minor-units convention for money everywhere else
// (pricing_rules, orders.pricing_snapshot) -- §23's "never trust the
// client" rule extends to never risking float rounding on money either.
model Payment {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  provider          String
  // 6.5: @unique -- the webhook endpoint looks a payment up by exactly
  // this id to know which order an incoming event belongs to; Postgres
  // allows multiple NULLs under a unique constraint, so this doesn't
  // conflict with rows that never reached a real provider checkout.
  providerPaymentId String?       @unique @map("provider_payment_id")
  // 6.4: not in §57's bare table sketch, but needed for real behavior
  // -- a second `POST /payments/checkout` call for the same order
  // reuses this stored URL instead of asking the provider to mint a
  // new checkout session (which would produce a different
  // providerPaymentId each time).
  checkoutUrl       String?       @map("checkout_url")
  amountMinor       Int           @map("amount_minor")
  currency          String
  status            PaymentStatus @default(PENDING)
  // 23.10: when this payment FIRST became money (PAID or any later refund state). Stamped by
  // a database trigger the first time status enters that set, so no writer can forget it and
  // no later touch of the row (a refund, a webhook replay) moves it. Reports date revenue by
  // this, never by updated_at.
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id])
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([paidAt])
  @@map("payments")
}

// 6.1/§58/§76/§92: `providerEventId` is `@unique` -- the database
// itself is the idempotency backstop for "the same webhook delivered 5
// times produces exactly one financial operation" (6.5's own
// Done-when), not application logic alone. `processedAt` stays null
// until the event has actually been applied (its own state transition
// run) -- a row can exist (the unique constraint claimed) before that
// happens, same "claim, then execute" shape as 5.3's idempotency keys.
model PaymentEvent {
  id              String    @id @default(uuid())
  paymentId       String    @map("payment_id")
  providerEventId String    @unique @map("provider_event_id")
  eventType       String    @map("event_type")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

// 11.1/§80. Denormalizes order_id alongside payment_id -- the same
// "convenient direct FK, not just a join-away hop" reasoning
// print_jobs already established for its own shop_id alongside
// order_id -- so 11.1's own Done-when ("refunds are linked to both the
// original payment and order") holds literally, and a shop-order-
// history or customer-order-history view can query refunds by orderId
// directly. amountMinor/currency are snapshotted at refund-creation
// time rather than read live off Payment, the same "never trust a live
// join for money, snapshot it" reasoning orders.pricing_snapshot
// already established -- moot for MVP (partial refunds are explicitly
// out of scope, so this always equals the payment's own amount today)
// but still the more honest, auditable shape for a financial record.
// `status` reuses PaymentStatus rather than a second, parallel enum --
// 11.2's own refund state machine only ever needs REFUND_PENDING,
// REFUND_FAILED and REFUNDED, all three already defined there (Payment
// itself moves through the same three values in lockstep), so a
// dedicated RefundStatus enum would just be a second name for the same
// three strings with a real risk of drifting out of sync. actorId is
// nullable for the same reason OrderStateMachine's TransitionActor.id
// already is -- a system-driven refund (11.3's own automatic triggers)
// has no human actor.
// 11.2/§80: `paymentId` is `@unique` -- MVP disallows partial refunds
// (per the plan's own §120-P2 scope note), so a payment can have at
// most one refund ever. That single row is retried in place (a fresh
// REFUND_PENDING or a retry after REFUND_FAILED reuses it), never
// re-created -- the same "the database is the idempotency backstop,
// not application logic alone" reasoning 6.1's own payment_events
// unique constraint already established, applied here via
// RefundService's `upsert` instead of an explicit `ON CONFLICT`.
model Refund {
  id               String        @id @default(uuid())
  paymentId        String        @unique @map("payment_id")
  orderId          String        @map("order_id")
  providerRefundId String?       @unique @map("provider_refund_id")
  amountMinor      Int           @map("amount_minor")
  currency         String
  status           PaymentStatus @default(REFUND_PENDING)
  reason           String
  actorId          String?       @map("actor_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
  actor   User?   @relation("RefundActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([status, updatedAt])
  @@map("refunds")
}

// §38/§49/8.4. `capabilities` mirrors packages/types' `PrinterCapabilities`,
// same shape and same "null means not yet declared" convention as
// Shop.capabilities. Printers are registered directly under a shop by
// shop staff (8.4) -- Phase 9's agent doesn't exist yet at this point in
// the plan; 9.1-9.6 attach real device identity and discovery on top of
// rows that already exist, rather than the agent being the only thing
// that can ever create one.
//
// 15.3/§16 expands the original 4 values with BUSY/PAUSED/MAINTENANCE/
// UNKNOWN -- additive only (Postgres `ALTER TYPE ... ADD VALUE`, never
// remove/rename), since ONLINE/OFFLINE/ERROR/DISABLED are already
// persisted data and cross the agent wire as literal strings. §16's own
// rule -- never assume a printer is available when its status is
// UNKNOWN -- is a Phase 18 allocation-engine concern, not encoded here;
// this migration only makes the value representable.
enum PrinterStatus {
  ONLINE
  OFFLINE
  ERROR
  DISABLED
  BUSY
  PAUSED
  MAINTENANCE
  UNKNOWN
}

model Printer {
  id                  String        @id @default(uuid())
  shopId              String        @map("shop_id")
  // §41/9.4. Nullable -- a printer registered by staff (8.4) before
  // any agent is ever installed has no agent yet. Set the first time
  // a heartbeat reports a printer this shop's agent knows about
  // (matched by name, then created if no existing row matches);
  // that's also what makes "this agent's printers" a well-defined set
  // for the missed-heartbeat sweep to mark OFFLINE.
  agentId             String?       @map("agent_id")
  name                String
  capabilities        Json?
  status              PrinterStatus @default(OFFLINE)
  // 15.3/§16's printer profile fields, all nullable/defaulted so every
  // printer row created before this migration is unaffected.
  // `model`/`location`/`connectionType` are plain free-text (the make/
  // model string, a physical/human location note, and a connection
  // description like "USB"/"Network" -- none of these are closed
  // enumerations worth a Postgres enum type for, and staff should be
  // able to describe them without a schema migration every time a new
  // connection type shows up).
  model               String?
  // Staff-set (never agent-reported -- 15.6 is explicit that the
  // agent must never overwrite this with null on a heartbeat that
  // simply doesn't carry a location).
  location            String?
  connectionType      String?       @map("connection_type")
  // §16/§64: what this printer can physically handle, as native
  // Postgres text arrays -- not JSON, to match `PaperSize`/`PaperType`
  // being plain string enums (packages/types) rather than an object
  // shape the way `capabilities` (a fixed {color,duplex,a4,a3} record)
  // is. A text array lets Phase 18's allocation engine filter with a
  // plain `hasSome`/`hasEvery` instead of unpacking JSON, and lets
  // Postgres enforce "this is a list of strings" structurally, which
  // a Json column can't. Defaults to an empty array (Prisma disallows
  // a nullable list field), meaning "nothing declared yet" the same
  // way `capabilities: null` already does for the boolean shape --
  // callers must treat an empty array as "unknown", not "supports
  // nothing", the same non-guessing rule 15.2 established for
  // `capabilities === null` on the auto-dispatch path.
  supportedSizes      String[]      @default([]) @map("supported_sizes")
  supportedPaperTypes String[]      @default([]) @map("supported_paper_types")
  maxJobPages         Int?          @map("max_job_pages")
  // Plain text, not a second enum alongside PrinterStatus. PrinterStatus
  // (specifically its new MAINTENANCE value) is the machine-readable
  // state allocation/dispatch decisions key off; `maintenanceStatus` is
  // staff-facing descriptive detail about *why* or *what* (e.g. "toner
  // replacement due", "servicing booked 2026-10-01") that nothing in
  // this codebase branches on. Making it a second closed enum would
  // either duplicate PrinterStatus's own values or invite the two
  // getting out of sync; free text avoids both.
  maintenanceStatus   String?       @map("maintenance_status")
  lastStatusAt        DateTime?     @map("last_status_at")
  // 19.1: opt-in page limit (PRD 23). Enforcement only when enabled AND set.
  pageLimit           Int?          @map("page_limit")
  pageLimitEnabled    Boolean       @default(false) @map("page_limit_enabled")
  pageLimitPeriod     PageLimitPeriod @default(DAILY) @map("page_limit_period")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  agent     PrinterAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  printJobs PrintJob[]
  pageUsage PrinterPageUsage[]

  @@index([shopId])
  @@index([agentId])
  // 23.6: trigram index so ILIKE %term% search is indexed (phase23_search_indexes migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "printers_name_trgm_idx")
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin, map: "printers_model_trgm_idx")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "printers_location_trgm_idx")
  @@map("printers")
}

// §45/8.1. `shopId` is denormalized from the order/printer (both belong
// to the same shop by construction, enforced in the service layer, not
// a DB constraint) rather than joined every time -- 8.2's shop-scoped
// queries need it directly indexed, matching this sub-phase's own
// Done-when. `idempotencyToken` is the client-generated key from 8.8's
// "one key per Accept attempt" -- `@unique` is what makes double-tapping
// Accept create exactly one job (8.3's Done-when) a database guarantee,
// not just an application-level check. `claimedAt`/`osJobId` are 9.7's
// and 9.11's respectively; carried in this migration now because 8.1
// explicitly calls for them, even though nothing writes them until
// Phase 9.
model PrintJob {
  id               String         @id @default(uuid())
  orderId          String         @map("order_id")
  // 18.6: nullable as of this phase -- a job that allocatePrinter()
  // couldn't place anywhere (WAITING, blockedReason set) has no
  // printer yet. Every job that DOES have a printerId still means
  // exactly what it always has; nothing here changes for an allocated
  // job.
  printerId        String?        @map("printer_id")
  shopId           String         @map("shop_id")
  // 18.1: CREATED is the new default -- a freshly-exploded job starts
  // unallocated; dispatch (18.5) moves it to QUEUED (allocated) or
  // WAITING (blocked) via the job state machine, never by construction.
  status           PrintJobStatus @default(CREATED)
  idempotencyToken String         @unique @map("idempotency_token")
  claimedAt        DateTime?      @map("claimed_at")
  osJobId          String?        @map("os_job_id")
  // 15.4: the groundwork Phase 18's job-lifecycle split depends on.
  // orderItemId is nullable FOR NOW (deliberately -- tightening it to
  // NOT NULL is a later follow-up once every writer sets it; this
  // migration only adds the column and backfills it for existing
  // rows). blockedReason/pausedAt/supersededAt/attempt/priority are
  // all unused by any code path yet -- Phase 18 (blockedReason,
  // pausedAt, attempt/priority for the allocation engine) and this
  // same migration's own backfill (supersededAt, reproducing today's
  // SHOP_ORDER_INCLUDE `take: 1` as real data) are what write them.
  orderItemId      String?        @map("order_item_id")
  blockedReason    String?        @map("blocked_reason")
  supersededAt     DateTime?      @map("superseded_at")
  pausedAt         DateTime?      @map("paused_at")
  // 21.2 (PRD 66): the operator's failure-reason picker; NULL until one is chosen.
  failureReason    JobFailureReason? @map("failure_reason")
  failureNote      String?        @map("failure_note")
  attempt          Int            @default(1)
  priority         Int            @default(0)
  // 18.9: manual (and, gated by its own toggle, automatic) assignment
  // of a job to a specific OPERATOR user. Nullable -- most jobs today
  // have no operator assigned at all; SetNull so removing a staff
  // member's account never takes job history down with it.
  operatorId       String?        @map("operator_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  order     Order      @relation(fields: [orderId], references: [id])
  // 18.23: explicit Restrict, matching what the database has always enforced. Phase 18
  // made printer_id nullable (a blocked job has no printer yet), and Prisma's default
  // for an OPTIONAL relation is SetNull -- so with no explicit onDelete the schema
  // silently claimed ON DELETE SET NULL while the DB kept RESTRICT, and the next
  // `prisma migrate dev` would have flipped it: deleting a printer would then erase
  // which printer printed every historical job. Restrict keeps job history intact.
  printer   Printer?   @relation(fields: [printerId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  operator  User?      @relation("PrintJobOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  // 21.4: this job's reprint (at most one), and, when this job IS a reprint, its link.
  reprintedAs PrintJobReprint? @relation("ReprintOriginal")
  reprintOf   PrintJobReprint? @relation("ReprintJob")

  @@index([shopId])
  @@index([orderId])
  @@index([printerId])
  @@index([orderItemId])
  @@index([operatorId])
  // 23.2: per-shop job aggregates by status and completion time; the operator's own queue.
  @@index([shopId, status, updatedAt])
  @@index([operatorId, status])
  @@map("print_jobs")
}

// 15.4/§64. An order can require several, differently-configured
// production steps -- the PRD's own example is one order containing
// 100 A4 BW pages, 50 A4 color pages, and 10 laminated pages, each
// needing a different production path. OrderItem is the "what"; a
// PrintJob (Phase 18) is "how a specific printer/agent executed one
// item." printConfiguration/pricingSnapshot mirror Order's own fields
// exactly (same shape, same reasoning) but are per-item once an order
// has more than one. Every order has at least one item: this
// migration backfills exactly one synthetic PRINT item per
// pre-existing order from that order's own document_id +
// print_configuration; real multi-item orders start once Phase 17/18
// ship the machinery to create more than one, gated by
// shops.multiItemEnabled.
enum OrderItemType {
  PRINT
  LAMINATE
  BIND
}

model OrderItem {
  id                 String        @id @default(uuid())
  orderId            String        @map("order_id")
  documentId         String        @map("document_id")
  printConfiguration Json          @map("print_configuration")
  quantity           Int
  itemType           OrderItemType @map("item_type")
  required           Boolean       @default(true)
  pricingSnapshot    Json?         @map("pricing_snapshot")
  sequence           Int
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  document  Document   @relation(fields: [documentId], references: [id])
  printJobs PrintJob[]

  @@unique([orderId, sequence])
  @@index([orderId])
  @@index([documentId])
  @@map("order_items")
}

// 21.5 (PRD 71). Mirrored in packages/types (enum-mirror.spec.ts).
enum DeliveryStatus {
  PENDING
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

// 21.5 (PRD 71). The optional delivery workflow: at most one record per order.
// The fee is recorded only (a price change never alters a confirmed order, so
// the order's pricing snapshot is never touched). shop_id is a plain column, like
// print_jobs.shop_id.
model OrderDelivery {
  id             String         @id @default(uuid())
  orderId        String         @unique @map("order_id")
  shopId         String         @map("shop_id")
  status         DeliveryStatus @default(PENDING)
  address        String
  courier        String?
  trackingNumber String?        @map("tracking_number")
  feeMinor       Int            @default(0) @map("fee_minor")
  dispatchedAt   DateTime?      @map("dispatched_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@map("order_deliveries")
}

// 21.4 (PRD 67). Mirrored in packages/types (enum-mirror.spec.ts).
enum ReprintReason {
  PRINTER_ERROR
  PAPER_JAM
  WRONG_PAPER
  POOR_QUALITY
  FILE_PROBLEM
  INK_TONER
  HARDWARE
  CUSTOMER_REQUEST
  OTHER
}

// 21.4 (PRD 67). A reprint is a NEW print_jobs row created through the normal
// allocation path; this row links it to the job it reprints and records why, who,
// when and the additional cost (recorded only: a price change never alters a
// confirmed order, so the order's pricing snapshot is not touched). original_job_id
// is UNIQUE: a job can be reprinted at most once (a reprint can itself be reprinted).
// shop_id/order_id are plain columns, like print_jobs.shop_id.
model PrintJobReprint {
  id                  String        @id @default(uuid())
  shopId              String        @map("shop_id")
  orderId             String        @map("order_id")
  originalJobId       String        @unique @map("original_job_id")
  reprintJobId        String        @unique @map("reprint_job_id")
  reason              ReprintReason
  note                String?
  requestedBy         String?       @map("requested_by")
  additionalCostMinor Int           @default(0) @map("additional_cost_minor")
  // STAFF (the reprint endpoint) or QUALITY_CHECK (a NEEDS_REPRINT verdict).
  source              String        @default("STAFF")
  createdAt           DateTime      @default(now()) @map("created_at")

  originalJob PrintJob @relation("ReprintOriginal", fields: [originalJobId], references: [id], onDelete: Restrict)
  reprintJob  PrintJob @relation("ReprintJob", fields: [reprintJobId], references: [id], onDelete: Restrict)
  requester   User?    @relation("PrintJobReprintRequester", fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([orderId])
  @@map("print_job_reprints")
}

// 21.2 (PRD 66). Mirrored in packages/types (enum-mirror.spec.ts).
enum JobFailureReason {
  PRINTER_ERROR
  PAPER_JAM
  WRONG_PAPER
  POOR_QUALITY
  FILE_PROBLEM
  INK_TONER
  HARDWARE
}

enum PrintJobStatus {
  // 18.1: additive only. CLAIMED/PRINTED keep their exact names -- both
  // strings cross the agent wire (15.6 froze that contract). CREATED:
  // a job exploded from an order item but not yet allocated to a
  // printer. WAITING: allocation was attempted and failed (18.6's
  // blockedReason explains why) -- a job re-enters WAITING, never
  // CREATED, on every subsequent failed allocation retry. PAUSED:
  // operator-paused (21.1). REASSIGNED: superseded by a manual
  // reassignment (18.7) -- the terminal status of the OLD job row, not
  // the new one, which starts its own lifecycle at CREATED/QUEUED.
  CREATED
  WAITING
  QUEUED
  CLAIMED
  PRINTING
  PRINTED
  PAUSED
  REASSIGNED
  FAILED
  UNKNOWN
  TIMEOUT
  CANCELLED
}

// §41/9.1. A device's own lifecycle (ACTIVE once paired, REVOKED if
// staff removes it) -- deliberately not the same enum as PrinterStatus
// (ONLINE/OFFLINE/ERROR/DISABLED). That tracks a *printer's* own
// heartbeat-derived connectivity (9.4 sets it from an active agent's
// heartbeat); this tracks whether the *agent's own credential* is
// still valid at all. `publicKey` is the Ed25519 public key the agent
// generated locally and never transmits the private half of (§41's
// own "prefer cryptographic device identity over shared passwords") --
// never a shared secret, per this sub-phase's own Done-when.
enum PrinterAgentStatus {
  ACTIVE
  REVOKED
}

model PrinterAgent {
  id         String             @id @default(uuid())
  deviceId   String             @unique @map("device_id")
  shopId     String             @map("shop_id")
  publicKey  String             @map("public_key")
  status     PrinterAgentStatus @default(ACTIVE)
  lastSeenAt DateTime?          @map("last_seen_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  printers Printer[]

  @@index([shopId])
  @@map("printer_agents")
}

// §41/9.2. `codeHash` (never the raw code, same "identified by its
// hash" convention as refresh_tokens/password_reset_tokens) is
// `@unique` so a redemption lookup is a single indexed query.
// `consumedAt` makes it single-use: 9.2's own Done-when ("a second
// redemption returns 410") is checked by the service, not a DB
// constraint, since "already consumed" and "expired" both need their
// own distinct 410 rather than a generic constraint-violation 500.
model AgentPairingCode {
  id         String    @id @default(uuid())
  codeHash   String    @unique @map("code_hash")
  shopId     String    @map("shop_id")
  createdBy  String    @map("created_by")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  shop    Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id])

  @@index([shopId])
  @@map("agent_pairing_codes")
}

enum PageLimitPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

// 19.1: usage per printer per UTC period. period_start is part of the key,
// so rollover needs no reset job.
model PrinterPageUsage {
  id          String   @id @default(uuid())
  printerId   String   @map("printer_id")
  periodStart DateTime @map("period_start")
  pagesUsed   Int      @default(0) @map("pages_used")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@unique([printerId, periodStart])
  @@map("printer_page_usage")
}

// 20.1/§27: the six movement kinds the PRD lists. The signed delta on the row is
// authoritative; the type says why. Mirrored in packages/types.
enum InventoryMovementType {
  PURCHASE
  ADJUSTMENT
  CONSUMPTION
  RETURN
  TRANSFER
  CORRECTION
}

// 20.1/§26: a shop's tracked stock line (paper stock today; any counted
// consumable fits). Only rows with paper_size set take part in the paper
// availability gate (20.3) and consumption (20.4). `quantity` is only ever
// changed by the atomic stock function in backend-shared (never
// read-modify-write) and is guarded by a CHECK >= 0 as a last line of
// defence. Items are deactivated (`active=false`), never deleted, so movement
// history keeps its subject. Supplier links are many-to-many (20.6), so there is
// deliberately no supplier column here.
model InventoryItem {
  id            String   @id @default(uuid())
  shopId        String   @map("shop_id")
  name          String
  sku           String?
  paperSize     String?  @map("paper_size")
  paperType     String?  @map("paper_type")
  weightGsm     Int?     @map("weight_gsm")
  quantity      Int      @default(0)
  minQuantity   Int      @default(0) @map("min_quantity")
  maxQuantity   Int?     @map("max_quantity")
  location      String?
  unitCostMinor Int?     @map("unit_cost_minor")
  active        Boolean  @default(true)
  // 20.5: dedupe latch for low-stock alerts (set on raise, cleared on recovery).
  lowStockAlertedAt DateTime? @map("low_stock_alerted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
  alerts    InventoryAlert[]
  supplierProducts SupplierProduct[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([id, shopId])
  @@unique([shopId, sku])
  @@index([shopId])
  @@index([shopId, paperSize])
  // 23.6: trigram index so ILIKE %term% search is indexed (phase23_search_indexes migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "inventory_items_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "inventory_items_sku_trgm_idx")
  @@map("inventory_items")
}

// 20.1/§27: append-only ledger (a DB trigger rejects UPDATE). Every row is
// also mirrored into audit_logs by the writer, in the same transaction.
// `idempotencyKey` (nullable, unique) makes a replayed job consumption or
// purchase-order receipt physically unable to record twice.
model InventoryMovement {
  id              String                @id @default(uuid())
  shopId          String                @map("shop_id")
  inventoryItemId String                @map("inventory_item_id")
  type            InventoryMovementType
  quantityDelta   Int                   @map("quantity_delta")
  quantityAfter   Int                   @map("quantity_after")
  reason          String?
  actorId         String?               @map("actor_id")
  // No FK on purpose: a plain reference, so print-job housekeeping never has to
  // UPDATE (and the append-only trigger never has to allow) ledger rows.
  printJobId      String?               @map("print_job_id")
  idempotencyKey  String?               @unique @map("idempotency_key")
  createdAt       DateTime              @default(now()) @map("created_at")

  shop  Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  actor User?         @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([shopId, createdAt])
  @@index([printJobId])
  @@map("inventory_movements")
}

enum InventoryAlertStatus {
  OPEN
  RESOLVED
}

// 20.5/§32: a low-stock alert. One OPEN alert per item at a time (guarded by
// inventory_items.low_stock_alerted_at); resolved when stock recovers.
model InventoryAlert {
  id              String               @id @default(uuid())
  shopId          String               @map("shop_id")
  inventoryItemId String               @map("inventory_item_id")
  status          InventoryAlertStatus @default(OPEN)
  quantityAtAlert Int                  @map("quantity_at_alert")
  minQuantity     Int                  @map("min_quantity")
  createdAt       DateTime             @default(now()) @map("created_at")
  resolvedAt      DateTime?            @map("resolved_at")

  shop Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([shopId, status, createdAt])
  @@index([inventoryItemId, status])
  @@map("inventory_alerts")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

// 20.6/§29: a shop's supplier. Deactivated (status), never deleted.
model Supplier {
  id           String         @id @default(uuid())
  shopId       String         @map("shop_id")
  name         String
  contactName  String?        @map("contact_name")
  email        String?
  phone        String?
  address      String?
  paymentTerms String?        @map("payment_terms")
  status       SupplierStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")

  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@unique([id, shopId])
  @@index([shopId])
  // 23.6: trigram index so ILIKE %term% search is indexed (phase23_search_indexes migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "suppliers_name_trgm_idx")
  @@map("suppliers")
}

// 20.6/§30: many-to-many between suppliers and inventory items, with the
// supplier's own SKU/price/lead time. Composite FKs on (id, shop_id) make a
// cross-shop link impossible at the database level.
model SupplierProduct {
  id              String   @id @default(uuid())
  shopId          String   @map("shop_id")
  supplierId      String   @map("supplier_id")
  inventoryItemId String   @map("inventory_item_id")
  supplierSku     String?  @map("supplier_sku")
  unitPriceMinor  Int?     @map("unit_price_minor")
  leadTimeDays    Int?     @map("lead_time_days")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  supplier Supplier      @relation(fields: [supplierId, shopId], references: [id, shopId], onDelete: Cascade, map: "supplier_products_supplier_shop_fkey")
  item     InventoryItem @relation(fields: [inventoryItemId, shopId], references: [id, shopId], onDelete: Cascade, map: "supplier_products_item_shop_fkey")

  @@unique([supplierId, inventoryItemId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@map("supplier_products")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// 20.7/31: a purchase order to a supplier. DRAFT -> ORDERED -> RECEIVED (or
// CANCELLED from DRAFT/ORDERED). Receiving writes inventory movements in the
// same transaction and is idempotent (row lock + status guard + per-line unique
// movement keys). po_number comes from a DB sequence default.
model PurchaseOrder {
  id                 String                     @id @default(uuid())
  shopId             String                     @map("shop_id")
  supplierId         String                     @map("supplier_id")
  poNumber           String                     @default(dbgenerated("('PO-'::text || lpad((nextval('purchase_order_number_seq'::regclass))::text, 6, '0'::text))")) @map("po_number")
  status             PurchaseOrderStatus        @default(DRAFT)
  paymentStatus      PurchaseOrderPaymentStatus @default(UNPAID) @map("payment_status")
  expectedDeliveryAt DateTime?                  @map("expected_delivery_at")
  actualDeliveryAt   DateTime?                  @map("actual_delivery_at")
  totalCostMinor     Int                        @default(0) @map("total_cost_minor")
  notes              String?
  createdBy          String?                    @map("created_by")
  receivedBy         String?                    @map("received_by")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at")

  shop     Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId, shopId], references: [id, shopId], onDelete: Cascade, map: "purchase_orders_supplier_shop_fkey")
  creator  User?               @relation("PurchaseOrderCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  receiver User?               @relation("PurchaseOrderReceiver", fields: [receivedBy], references: [id], onDelete: SetNull)
  lines    PurchaseOrderLine[]

  @@unique([id, shopId])
  @@unique([shopId, poNumber])
  @@index([shopId, status, createdAt])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  shopId           String  @map("shop_id")
  purchaseOrderId  String  @map("purchase_order_id")
  inventoryItemId  String  @map("inventory_item_id")
  quantityOrdered  Int     @map("quantity_ordered")
  unitCostMinor    Int     @default(0) @map("unit_cost_minor")
  quantityReceived Int?    @map("quantity_received")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId, shopId], references: [id, shopId], onDelete: Cascade, map: "purchase_order_lines_po_shop_fkey")
  item          InventoryItem @relation(fields: [inventoryItemId, shopId], references: [id, shopId], onDelete: Cascade, map: "purchase_order_lines_item_shop_fkey")

  @@unique([purchaseOrderId, inventoryItemId])
  @@index([shopId])
  @@index([inventoryItemId])
  @@map("purchase_order_lines")
}

// 22.1 (PRD 75/76): one row per shop, always present (a trigger on `shops`
// creates it, migration 20260929100000). Holds business configuration and the
// automation toggles that did not already exist. The four older per-shop flags
// (auto_failover_enabled, inventory_tracking_enabled, quality_check_enabled,
// multi_item_enabled) STAY on `shops`, the source of truth for every hot-path
// read (allocation, machine, sweeps), and are edited through the settings API.
// `version` is optimistic concurrency: every write bumps it, and a PUT that
// carries a stale expectedVersion is refused, so two admins cannot silently
// clobber each other. Defaults reproduce today's behaviour exactly: every
// automatic path that exists today is ON, and automatic operator assignment
// (no automatic path exists) is OFF.
model ShopSettings {
  shopId                        String   @id @map("shop_id")
  version                       Int      @default(0)
  currency                      String   @default("PKR")
  taxRateBasisPoints            Int?     @map("tax_rate_basis_points")
  operatingHours                Json?    @map("operating_hours")
  notificationSettings          Json     @default("{\"emailEnabled\":true,\"appEnabled\":true}") @map("notification_settings")
  autoPrinterAssignmentEnabled  Boolean  @default(true) @map("auto_printer_assignment_enabled")
  autoOperatorAssignmentEnabled Boolean  @default(false) @map("auto_operator_assignment_enabled")
  autoQueueManagementEnabled    Boolean  @default(true) @map("auto_queue_management_enabled")
  inventoryAlertsEnabled        Boolean  @default(true) @map("inventory_alerts_enabled")
  automaticNotificationsEnabled Boolean  @default(true) @map("automatic_notifications_enabled")
  pageLimitEnforcementEnabled   Boolean  @default(true) @map("page_limit_enforcement_enabled")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @default(now()) @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

// 26.1 (default corrected by the 20261001100100 follow-up migration): one row
// per shop, mirroring ShopSettings's pattern -- a trigger on `shops` creates it
// for every shop, so readers never see "no row" and a row lock (FOR SHARE) is a
// real barrier against a concurrent activate/renew write. A shop is active when
// `expiresAt` is non-null and in the future. A new shop is NOT provisioned with
// `expiresAt = null` (which would read as expired from the instant it exists,
// requiring day-one admin activation before it could ever print -- breaking
// every one of the dozens of e2e fixtures that create a shop directly, and
// stopping a real new business from printing before an admin has even seen it):
// the trigger gives it a 30-day grace period instead, and a shop that existed
// before this feature shipped is grandfathered out to 3650 days. `expiresAt`
// stays nullable -- an admin can still let a plan lapse to null -- and
// ShopPlanService.isActiveAt still treats null as expired; only the default
// PROVISIONING value changes. `activatedByUserId` is a bare id like
// `ShopStaffInvite.invitedBy` / `AuditLog.actorId` -- no FK, so an admin account
// being removed later never blocks reading plan history.
//
// Plan management: `planDefinitionId` is the named, priced plan this business is
// on. Nullable -- a business only ever activated the old way (a raw day count,
// before plan definitions existed), never assigned one, or whose plan an admin
// cancelled has none, and reads as `plan: null`, never a crash. The FK is
// RESTRICT, not SET NULL: PlanDefinitionService refuses deleting a plan anyone
// is assigned to (409 PLAN_DEFINITION_IN_USE), and RESTRICT makes the database
// refuse it too, so a delete racing a concurrent assign can never silently
// strip that business's assignment.
model ShopPlan {
  shopId           String    @id @map("shop_id")
  expiresAt        DateTime? @map("expires_at")
  activatedAt      DateTime? @map("activated_at")
  activatedByUserId String?  @map("activated_by_user_id")
  planDefinitionId String?   @map("plan_definition_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planDefinition PlanDefinition? @relation(fields: [planDefinitionId], references: [id], onDelete: Restrict)

  @@index([planDefinitionId])
  @@map("shop_plans")
}

// Plan management: a platform-wide, nameable plan tier (name, price, currency,
// billing period) an admin defines once and assigns to any number of businesses
// via ShopPlan.planDefinitionId. `priceMinor` is integer minor units, the same
// money convention as PricingRule.pricePerPageMinor. Activating/renewing a
// business extends its expiry by THIS plan's `billingPeriodDays` -- never a
// client-supplied number. `archived` retires a plan from new assignment without
// touching the businesses already on it; a hard delete is only allowed once no
// business is assigned to it (see ShopPlan's RESTRICT FK).
model PlanDefinition {
  id                String   @id @default(uuid())
  name              String   @unique
  priceMinor        Int      @map("price_minor")
  currency          String
  billingPeriodDays Int      @map("billing_period_days")
  description       String?
  archived          Boolean  @default(false)
  // Price for 365 days; null = no annual option. The struck-out "monthly x 12" price
  // is computed by the marketing site, never stored.
  annualPriceMinor  Int?     @map("annual_price_minor")
  // "Most popular" badge + emphasised card.
  highlighted       Boolean  @default(false)
  // Custom pricing: card shows "Custom pricing" + "Contact us"; price_minor is ignored.
  contactOnly       Boolean  @default(false) @map("contact_only")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  shopPlans     ShopPlan[]
  featureValues PlanFeatureValue[]
  paymentProofs PaymentProof[]

  @@map("plan_definitions")
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

// Manual plan billing: a business owner pays the platform outside the app (bank,
// Easypaisa, JazzCash) and submits proof; a platform admin approves it (granting
// `grantedMonths` of access via ShopPlanService.activateInTx) or rejects it. The file
// lives in S3 under `fileKey` FOREVER -- nothing deletes it, rejected proofs included.
// Money is integer minor units, like PlanDefinition.priceMinor. `submittedByUserId` /
// `reviewedByUserId` are bare ids with no FK, like ShopPlan.activatedByUserId. The FK
// to the plan is RESTRICT so a plan with proofs against it cannot be hard-deleted out
// from under the billing history. A partial unique index (migration SQL) allows at
// most one PENDING proof per shop.
model PaymentProof {
  id                String             @id @default(uuid())
  shopId            String             @map("shop_id")
  submittedByUserId String             @map("submitted_by_user_id")
  planDefinitionId  String             @map("plan_definition_id")
  amountMinor       Int                @map("amount_minor")
  currency          String
  transactionRef    String             @map("transaction_ref")
  fileKey           String             @map("file_key")
  fileName          String             @map("file_name")
  fileContentType   String             @map("file_content_type")
  fileSize          Int                @map("file_size")
  status            PaymentProofStatus @default(PENDING)
  reviewedByUserId  String?            @map("reviewed_by_user_id")
  reviewedAt        DateTime?          @map("reviewed_at")
  rejectionReason   String?            @map("rejection_reason")
  grantedMonths     Int?               @map("granted_months")
  createdAt         DateTime           @default(now()) @map("created_at")

  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planDefinition PlanDefinition @relation(fields: [planDefinitionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([shopId, createdAt])
  @@index([transactionRef])
  @@map("payment_proofs")
}

// Singleton (id is always 1): platform-wide text an admin edits -- where owners send
// their plan payments. Read by every shop's staff on the Billing screen.
model PlatformSettings {
  id                  Int      @id @default(1)
  paymentInstructions String   @default("") @map("payment_instructions")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  updatedByUserId     String?  @map("updated_by_user_id")

  @@map("platform_settings")
}

// A row of the public Compare plans table ("Printers", "Audit log", ...), defined once;
// each plan sets a value per row in plan_feature_values.
model PlanFeature {
  id         String   @id @default(uuid())
  section    String
  label      String
  sortOrder  Int      @default(0) @map("sort_order")
  // Also list this row as a bullet on each plan's pricing card.
  showOnCard Boolean  @default(false) @map("show_on_card")
  // Card bullet template, e.g. "{value} printers"; null = "<label>" for a tick and
  // "<label>: <value>" for text.
  cardText   String?  @map("card_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  values PlanFeatureValue[]

  @@unique([section, label])
  @@map("plan_features")
}

// "true" = tick, "false" = dash, anything else = the text shown (e.g. "10", "Unlimited").
// A missing row renders as a dash.
model PlanFeatureValue {
  planId    String @map("plan_id")
  featureId String @map("feature_id")
  value     String

  plan    PlanDefinition @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PlanFeature    @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
  @@map("plan_feature_values")
}

enum PrinterRuleAction {
  PREFER
  AVOID
}

// 22.3 (PRD 77): a shop's ordered printer-automation rules. Data, not code: they feed
// the pure allocatePrinter as an ADDITIONAL preference layer over the printers that
// already passed every hard filter (status, capability, paper, page limit), so a
// rule can never override one of those, and an empty rule set is today's behaviour
// exactly. Only ENABLED rules are read, in (position, id) order. `printer_ids` is a
// plain array with no FK on purpose: a deleted printer just stops matching. Rules are
// consulted only when a job is allocated, so editing one never moves an existing job.
model PrinterAutomationRule {
  id         String            @id @default(uuid())
  shopId     String            @map("shop_id")
  position   Int
  name       String
  enabled    Boolean           @default(true)
  action     PrinterRuleAction
  printerIds String[]          @map("printer_ids")
  conditions Json              @default("{}")
  version    Int               @default(0)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, position])
  @@map("printer_automation_rules")
}
