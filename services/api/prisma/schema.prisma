generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors packages/types' UserRole (§9). A user's account-level role;
// ShopStaff.role uses the same vocabulary for their role at one specific
// shop, since the same person can hold different roles at different shops.
enum UserRole {
  CUSTOMER
  SHOP_OWNER
  SHOP_MANAGER
  SHOP_COUNTER
  ADMIN
  // §46/16.1: added additively. OPERATOR runs the production floor,
  // PRINTER_MANAGER owns the printer fleet, SUPPLIER is a future
  // supplier-portal account -- none existed as a shop-staff role
  // before 16.1, so every existing row is unaffected.
  OPERATOR
  PRINTER_MANAGER
  SUPPLIER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// §52. password_hash is not listed in the PRD's table sketch, but §52
// explicitly defers auth-secret storage to "the selected authentication
// architecture" -- the locked decision (own JWT, argon2id) requires it.
model User {
  id           String     @id @default(uuid())
  role         UserRole
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  phone        String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  shopStaff           ShopStaff[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  documents           Document[]
  orders              Order[]
  notifications       Notification[]
  createdPairingCodes AgentPairingCode[]
  refundsActedOn      Refund[]             @relation("RefundActor")
  // 18.9: jobs this user (role OPERATOR) is manually or automatically
  // assigned to run.
  printJobsAsOperator PrintJob[]           @relation("PrintJobOperator")

  @@map("users")
}

// Refresh token rotation (1.4): each row is one issued token, identified
// by its hash (never the raw token). family_id links every token in one
// rotation chain; reuse of a revoked token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// §70 recovery flow (1.5): single-use, short-TTL. Identified by its hash,
// like refresh_tokens -- the raw token is never persisted. usedAt makes
// it single-use; a second consumption attempt is rejected.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// §107 -- a customer may never submit an order to a shop not currently
// accepting them.
enum ShopStatus {
  OPEN
  CLOSED
  BUSY
  TEMPORARILY_UNAVAILABLE
  SUSPENDED
}

// §53. `capabilities` mirrors packages/types' `PrinterCapabilities`
// (§18/§49 -- the same shape printers themselves will carry from Phase
// 8.4) as JSONB: {color, duplex, a4, a3}. Null means "not yet declared" --
// 4.3's shop discovery filter treats that as "matches nothing" rather
// than guessing, so an unconfigured shop is never wrongly offered for a
// configuration it might not support.
model Shop {
  id                  String     @id @default(uuid())
  name                String
  address             String
  latitude            Float?
  longitude           Float?
  phone               String?
  status              ShopStatus @default(CLOSED)
  openingHours        Json?      @map("opening_hours")
  capabilities        Json?
  // 15.4: both default false, so no existing shop's behaviour changes
  // the moment this column exists. qualityCheckEnabled is §68/21.3's
  // per-business QC toggle; multiItemEnabled gates Phase 18's order-
  // item explosion (§64) -- while false, a shop's orders keep taking
  // exactly the one synthetic OrderItem this migration backfills, even
  // after Phase 17/18 ship the machinery to create more than one.
  qualityCheckEnabled Boolean    @default(false) @map("quality_check_enabled")
  multiItemEnabled    Boolean    @default(false) @map("multi_item_enabled")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  staff             ShopStaff[]
  pricingRules      PricingRule[]
  orders            Order[]
  printers          Printer[]
  printerAgents     PrinterAgent[]
  agentPairingCodes AgentPairingCode[]
  customers         Customer[]
  products          Product[]

  @@map("shops")
}

// §13/17.1: a shop's own named product catalog (e.g. "Business Cards",
// "A4 Handout Booklet") -- distinct from PricingRule, which prices raw
// page/copy/color inputs generically. A Product is a shop-defined,
// named thing a customer or counter staff can pick, carrying its own
// descriptive/tax/requirement metadata; nothing here prices anything
// by itself yet (that's still PricingRule's job, extended in 17.2) --
// wiring a specific OrderItem to a specific Product is explicitly
// deferred to Phase 18 (§64's multi-item explosion), which is why this
// model has no relation to Order/OrderItem at all yet, only to Shop.
// Deliberately no assumption of a 1:1 with any one order: a Product
// outlives any single order and is reused across many.
//
// `printerRequirements` mirrors `Printer.capabilities`'s own
// {color, duplex, a4, a3} JSON shape (§18/§49) rather than inventing a
// new one -- "what this product needs a printer to support" is the
// same vocabulary as "what a printer supports". `paperRequirements`
// mirrors `PrintConfiguration`'s own paperSize/paperType fields
// (15.1/§64) for the same reason -- "what paper this product needs" is
// the same closed vocabulary a print job's own configuration already
// uses, not a freeform new shape.
model Product {
  id                    String   @id @default(uuid())
  shopId                String   @map("shop_id")
  name                  String
  description           String?
  // Free text, not a closed enum -- a shop's own product categories
  // ("Stationery", "Marketing Material", ...) are shop-specific
  // vocabulary, the same reasoning Printer.model/location/
  // connectionType already established for free-text profile fields.
  category              String?
  // e.g. "per page", "per copy", "per item" -- free text for the same
  // reason as category; nothing in this sub-phase's scope prices off
  // this field yet (17.2/17.3 extend PricingRule directly).
  unit                  String?
  // Matches PricingRule's own basis-points convention (17.2) rather
  // than a float percentage -- never floating point for anything
  // money- or rate-adjacent in this schema.
  taxRateBasisPoints    Int?     @map("tax_rate_basis_points")
  printerRequirements   Json?    @map("printer_requirements")
  paperRequirements     Json?    @map("paper_requirements")
  available             Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("products")
}

// 15.5/§33. A shop's OWN customer record -- distinct from `User`
// (self-service accounts, §4.1) the same way `customerRecordId` on
// Order is distinct from `customerId`: this is a walk-in customer a
// counter staff member describes, not someone who ever logged in.
// No email/phone uniqueness constraint on purpose -- two different
// customers can share a phone number (a household, a shared office
// line) and staff need to be able to record that rather than have it
// rejected as a duplicate.
model Customer {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  name      String
  phone     String?
  email     String?
  company   String?
  address   String?
  // §33 "Account status" -- a plain active/inactive flag rather than a
  // new enum for two states, matching ShopStaffStatus's own boolean-
  // shaped ACTIVE/REMOVED pattern in spirit without the ceremony of a
  // second enum type for something this simple.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([shopId])
  @@map("customers")
}

// §19/§20, Migration 003 (4.2). Versioned, not updated in place: a price
// change inserts a new row with version = previous + 1 rather than
// mutating the old one, which is what makes §20's "existing orders must
// not change when a shop reprices" possible once Phase 5 snapshots
// whichever row was current at order-creation time. The current rule
// for a shop is the row with the highest version -- no separate
// "isActive" flag needed since version order already answers that.
model PricingRule {
  id                         String   @id @default(uuid())
  shopId                     String   @map("shop_id")
  version                    Int
  currency                   String
  pricePerPageMinor          Int      @map("price_per_page_minor")
  colorSurchargePerPageMinor Int      @map("color_surcharge_per_page_minor")
  otherCharges               Json     @map("other_charges")
  minimumChargeMinor         Int      @map("minimum_charge_minor")
  // §14/17.2/17.3: packages/pricing's own PricingRule type additions,
  // persisted here so 17.3's new writer can actually store them. All
  // nullable -- every row created before this migration (including
  // every seed.ts row) has none of these set, which computeQuote()
  // already treats as "no surcharge/no tax configured," its own
  // pre-17.2 behaviour exactly. Json maps are keyed by the closed
  // PaperSize/PaperType/Finishing enums (packages/pricing's own type
  // comment explains why these are real typed columns, not another
  // otherCharges-style freeform entry).
  paperSizeSurchargePerPageMinor  Json? @map("paper_size_surcharge_per_page_minor")
  paperTypeSurchargePerPageMinor  Json? @map("paper_type_surcharge_per_page_minor")
  finishingChargeMinor            Json? @map("finishing_charge_minor")
  taxRateBasisPoints              Int?  @map("tax_rate_basis_points")
  createdAt                  DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, version])
  @@map("pricing_rules")
}

enum ShopStaffStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

// §54. (shop_id, user_id) is unique -- one membership row per person per
// shop; multi-shop staff get one row per shop, each with its own role.
model ShopStaff {
  id        String          @id @default(uuid())
  shopId    String          @map("shop_id")
  userId    String          @map("user_id")
  role      UserRole
  status    ShopStaffStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@map("shop_staff")
}

// §83. Append-only -- rows are never updated or deleted by application
// code. actorId is nullable for system-initiated actions with no human
// actor (e.g. an expiration worker).
model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}

// §14/§86 processing pipeline states. PENDING_UPLOAD: presigned PUT
// issued (2.5), nothing arrived yet. PROCESSING: 2.7's worker is
// validating/scanning/encrypting the quarantine object. READY: the
// encrypted object lives at storage_key = documents/{id}; encrypted_dek/
// iv/auth_tag/encryption_version are all set. REJECTED: failed
// validation; rejection_reason says which check failed, quarantine
// object was deleted either way (2.7's Done-when). DELETED: retention
// (Phase 11) removed the object; the row is kept for order history
// (7.5) with storage_key/encrypted_dek cleared.
enum DocumentStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
  DELETED
}

// §55, extended with the envelope-encryption fields §62 requires
// (encrypted_dek/iv/auth_tag/encryption_version -- the wrapped DEK from
// 2.2's KeyManagementService and the params 2.3's CryptoService needs to
// decrypt) and storage_key (2.1's quarantine/{id} vs documents/{id}
// layout; persisted explicitly rather than re-derived from id+status,
// so the object's actual current location is never ambiguous).
model Document {
  id                String         @id @default(uuid())
  ownerUserId       String         @map("owner_user_id")
  // 11.5: nullable as of its own migration -- a DELETED document (2.5's
  // own customer-initiated remove(), or 11.5's own retention sweep) has
  // its object genuinely gone from storage, so a non-null value here
  // must always mean "this key is live," never a dangling pointer to
  // something that no longer exists.
  storageKey        String?        @map("storage_key")
  filename          String
  mimeType          String         @map("mime_type")
  sizeBytes         Int            @map("size_bytes")
  pageCount         Int?           @map("page_count")
  checksum          String?
  encryptedDek      Bytes?         @map("encrypted_dek")
  iv                Bytes?
  authTag           Bytes?         @map("auth_tag")
  encryptionVersion Int?           @map("encryption_version")
  status            DocumentStatus @default(PENDING_UPLOAD)
  rejectionReason   String?        @map("rejection_reason")
  expiresAt         DateTime?      @map("expires_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  owner      User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  orders     Order[]
  orderItems OrderItem[]

  @@index([ownerUserId])
  @@index([status])
  @@map("documents")
}

// S25/S26, Migration 004 (5.1). payment_status and order_status are
// deliberately separate columns -- S26's own example (payment_status =
// PAID, order_status = PRINT_FAILED) is exactly why: they track two
// genuinely independent lifecycles, and conflating them into one
// column would make that state unrepresentable. Each is independently
// indexed (5.1's own Done-when) since shop/admin views will filter by
// one without caring about the other.
//
// print_configuration and pricing_snapshot are both JSONB, not a set
// of scalar columns mirroring S56's sketch (subtotal/platform_fee/
// total_amount/currency as their own columns) -- pricing_snapshot
// stores the *entire* computed Quote (packages/pricing, 4.1: every
// line item, not just the three totals), which is what S20's "the
// exact price configuration used must be stored with the order" and
// "existing orders must not change" actually need once a shop
// reprices (4.2's versioned pricing_rules) after the order exists.
// Nothing yet needs those totals as independently queryable/sortable
// columns; that can be added later against a real need rather than
// guessed at now.
model Order {
  id                 String        @id @default(uuid())
  publicOrderNumber  String        @unique @map("public_order_number")
  customerId         String        @map("customer_id")
  // 15.5/§33. Deliberately coexists with customerId above, never
  // replaces it: customerId is the self-service User who placed this
  // order through customer-web (non-nullable, unchanged);
  // customerRecordId is a shop's own walk-in customer record (a
  // Customer row, below) that Phase 17's counter-ordering flow will
  // start writing when a shop takes an order at the counter on
  // someone's behalf. Nullable because every order created before
  // Phase 17 -- and every self-service order after it -- has no walk-in
  // customer record at all. This migration only adds the column;
  // OrdersService.create() and every other writer are untouched, per
  // 15.5's own explicit scope (that wiring is Phase 17's job).
  //
  // 17.5 judgment call: for a COUNTER order, `customerId` (still
  // non-nullable -- 15.5 deliberately left it that way, per its own
  // migration comment above) is set to the STAFF MEMBER who created
  // the order, not a synthetic placeholder User. Reasoning: (1) it
  // avoids inventing and maintaining a fake per-shop "walk-in" account
  // with a fabricated email that could collide with a real signup and
  // that would need its own lifecycle; (2) OrderStateMachine's own
  // notification step (order-state-machine.ts) looks up
  // `customer.email` to send order-lifecycle emails -- routing those
  // to the staff member who placed the order on the customer's behalf
  // is a real, working inbox, not a bounce; (3) it keeps `customerId`
  // meaning exactly what it already means everywhere else in this
  // schema -- "the User account this order belongs to for read/
  // ownership purposes" -- which for a counter order genuinely is the
  // staff account that transacted it; the walk-in customer's own
  // actual identity/contact info lives at `customerRecordId` instead,
  // which is what 17.4's Customer record (not this field) is for.
  customerRecordId   String?       @map("customer_record_id")
  shopId             String        @map("shop_id")
  documentId         String        @map("document_id")
  printConfiguration Json          @map("print_configuration")
  pricingSnapshot    Json          @map("pricing_snapshot")
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus        OrderStatus   @default(DRAFT) @map("order_status")
  // 15.4/§68. Plain string, not an enum -- the small, stable set of
  // states (NOT_REQUIRED/PENDING/PASSED/FAILED, roughly) is Phase 21.3's
  // decision to make once the real QC workflow lands; a string column
  // lets this migration exist now without guessing that shape today.
  // Defaults to "NOT_REQUIRED" so every pre-existing and newly-created
  // order is unaffected until a shop turns on qualityCheckEnabled.
  qualityCheckStatus String?       @default("NOT_REQUIRED") @map("quality_check_status")
  // §4.2/§11/17.5. Defaults to CUSTOMER_WEB so every pre-existing order
  // (and every self-service order created after this migration) is
  // unaffected -- COUNTER is only ever written by 17.5's own shop-side
  // order-creation path.
  creationSource     OrderCreationSource @default(CUSTOMER_WEB) @map("creation_source")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  completedAt        DateTime?     @map("completed_at")

  customer       User           @relation(fields: [customerId], references: [id])
  // SetNull, not Cascade -- deleting a shop's walk-in customer record
  // (17.4's job, not this sub-phase's) should never take an order's
  // own history down with it, the same "the order survives" reasoning
  // PrintJob.orderItemId's own onDelete: SetNull already established.
  customerRecord Customer?      @relation(fields: [customerRecordId], references: [id], onDelete: SetNull)
  shop           Shop           @relation(fields: [shopId], references: [id])
  document       Document       @relation(fields: [documentId], references: [id])
  payments       Payment[]
  notifications  Notification[]
  printJobs      PrintJob[]
  refunds        Refund[]
  items          OrderItem[]

  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([customerId])
  @@index([customerRecordId])
  @@map("orders")
}

// §4.2/§11/17.5. CUSTOMER_WEB: self-service, keyed by
// orders.customer_id = the User who placed it through customer-web.
// COUNTER: staff placed it on a customer's behalf via `POST
// /shop/orders`. See Order.customerId's own comment for the judgment
// call on which User backs customerId for a COUNTER order.
enum OrderCreationSource {
  CUSTOMER_WEB
  COUNTER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum OrderStatus {
  DRAFT
  UPLOADED
  PAYMENT_PENDING
  PAID
  WAITING_FOR_SHOP
  SHOP_ACCEPTED
  QUEUED_FOR_PRINT
  PRINTING
  PRINTED
  READY_FOR_COLLECTION
  COMPLETED
  PAYMENT_FAILED
  SHOP_REJECTED
  PRINT_FAILED
  PRINT_STATUS_UNKNOWN
  CANCELLED
  EXPIRED
  // 18.2: four new order-level statuses, all reachable only via the
  // derived SYNC_JOBS path (aggregate-order-status.ts) except
  // QUALITY_CHECK's own QC_PASS/QC_FAIL/QC_REPRINT exits -- additive,
  // Postgres `ALTER TYPE ... ADD VALUE`, never a rename. PREPARING: an
  // order has been queued but its job(s) are not yet all allocated to
  // a printer (18.6's WAITING/blocked case). ASSIGNED: at least one job
  // has been claimed by an agent but none is actively printing yet.
  // PAUSED: every active job is paused (21.1). QUALITY_CHECK: every
  // required job printed and the shop's qualityCheckEnabled toggle is
  // on (21.3 builds the real staff workflow on top of this).
  PREPARING
  ASSIGNED
  PAUSED
  QUALITY_CHECK
}

// 5.2: PA-YYYYMMDD-NNNNNN order numbers, generated via
// INSERT ... ON CONFLICT (date_key) DO UPDATE ... RETURNING counter --
// atomic under concurrency (no read-then-write race), one row per
// calendar day so the sequence naturally resets daily without a
// separate reset job.
model OrderNumberCounter {
  dateKey String @id @map("date_key")
  counter Int    @default(0)

  @@map("order_number_counters")
}

// 5.3: `Idempotency-Key` header support. Scoped by (key, scope) rather
// than key alone -- a client-generated UUID is only meant to dedupe
// retries of the *same* logical operation; scoping by e.g.
// "POST /v1/orders" keeps two different endpoints from ever colliding
// on a coincidentally-reused key. request_hash is what lets a replay
// with an unexpectedly *different* body be detected and refused (422)
// instead of silently returning a stored response for a different request.
model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String
  scope          String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([key, scope])
  @@map("idempotency_keys")
}

// 7.1/§78. One row per (recipient, event) -- `type` names which of
// the seven §78 domain events this is, `channel` which delivery
// surface carries it (APP always; EMAIL only "where practical", per
// the PRD's own hedge). `sentAt` stays null until the channel's own
// transport actually dispatches it (7.2's queued send, retried on
// failure) -- a row existing is "this notification was decided," not
// "this notification was delivered." `readAt` is customer-web's own
// "mark as read" action on the in-app feed; irrelevant to EMAIL rows,
// which is why it's nullable rather than a second, channel-specific
// table.
model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  orderId   String              @map("order_id")
  type      NotificationType
  channel   NotificationChannel
  payload   Json
  sentAt    DateTime?           @map("sent_at")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  PAYMENT_CONFIRMED
  ORDER_ACCEPTED
  PRINT_STARTED
  PRINT_FAILED
  PRINT_COMPLETED
  READY_FOR_COLLECTION
  ORDER_COMPLETED
  // 11.3/§122: a real gap found while wiring the shop-rejection refund
  // trigger -- SHOP_REJECT had no entry in NOTIFICATION_TYPE_BY_EVENT
  // at all (7.3's own seven §78 events never included it), so
  // rejecting a paid order silently told the customer nothing, despite
  // 11.3's own Done-when explicitly requiring "rejecting a paid order
  // notifies the customer." Every order that ever reaches
  // WAITING_FOR_SHOP (the only state SHOP_REJECT is legal from) has
  // already been paid, so this notification's own text can say
  // "you'll be refunded" unconditionally rather than hedging.
  ORDER_REJECTED
}

enum NotificationChannel {
  APP
  EMAIL
}

// 6.1/§57. `amountMinor` (not `amount`) matches this codebase's
// existing integer-minor-units convention for money everywhere else
// (pricing_rules, orders.pricing_snapshot) -- §23's "never trust the
// client" rule extends to never risking float rounding on money either.
model Payment {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  provider          String
  // 6.5: @unique -- the webhook endpoint looks a payment up by exactly
  // this id to know which order an incoming event belongs to; Postgres
  // allows multiple NULLs under a unique constraint, so this doesn't
  // conflict with rows that never reached a real provider checkout.
  providerPaymentId String?       @unique @map("provider_payment_id")
  // 6.4: not in §57's bare table sketch, but needed for real behavior
  // -- a second `POST /payments/checkout` call for the same order
  // reuses this stored URL instead of asking the provider to mint a
  // new checkout session (which would produce a different
  // providerPaymentId each time).
  checkoutUrl       String?       @map("checkout_url")
  amountMinor       Int           @map("amount_minor")
  currency          String
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id])
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// 6.1/§58/§76/§92: `providerEventId` is `@unique` -- the database
// itself is the idempotency backstop for "the same webhook delivered 5
// times produces exactly one financial operation" (6.5's own
// Done-when), not application logic alone. `processedAt` stays null
// until the event has actually been applied (its own state transition
// run) -- a row can exist (the unique constraint claimed) before that
// happens, same "claim, then execute" shape as 5.3's idempotency keys.
model PaymentEvent {
  id              String    @id @default(uuid())
  paymentId       String    @map("payment_id")
  providerEventId String    @unique @map("provider_event_id")
  eventType       String    @map("event_type")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

// 11.1/§80. Denormalizes order_id alongside payment_id -- the same
// "convenient direct FK, not just a join-away hop" reasoning
// print_jobs already established for its own shop_id alongside
// order_id -- so 11.1's own Done-when ("refunds are linked to both the
// original payment and order") holds literally, and a shop-order-
// history or customer-order-history view can query refunds by orderId
// directly. amountMinor/currency are snapshotted at refund-creation
// time rather than read live off Payment, the same "never trust a live
// join for money, snapshot it" reasoning orders.pricing_snapshot
// already established -- moot for MVP (partial refunds are explicitly
// out of scope, so this always equals the payment's own amount today)
// but still the more honest, auditable shape for a financial record.
// `status` reuses PaymentStatus rather than a second, parallel enum --
// 11.2's own refund state machine only ever needs REFUND_PENDING,
// REFUND_FAILED and REFUNDED, all three already defined there (Payment
// itself moves through the same three values in lockstep), so a
// dedicated RefundStatus enum would just be a second name for the same
// three strings with a real risk of drifting out of sync. actorId is
// nullable for the same reason OrderStateMachine's TransitionActor.id
// already is -- a system-driven refund (11.3's own automatic triggers)
// has no human actor.
// 11.2/§80: `paymentId` is `@unique` -- MVP disallows partial refunds
// (per the plan's own §120-P2 scope note), so a payment can have at
// most one refund ever. That single row is retried in place (a fresh
// REFUND_PENDING or a retry after REFUND_FAILED reuses it), never
// re-created -- the same "the database is the idempotency backstop,
// not application logic alone" reasoning 6.1's own payment_events
// unique constraint already established, applied here via
// RefundService's `upsert` instead of an explicit `ON CONFLICT`.
model Refund {
  id               String        @id @default(uuid())
  paymentId        String        @unique @map("payment_id")
  orderId          String        @map("order_id")
  providerRefundId String?       @unique @map("provider_refund_id")
  amountMinor      Int           @map("amount_minor")
  currency         String
  status           PaymentStatus @default(REFUND_PENDING)
  reason           String
  actorId          String?       @map("actor_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
  actor   User?   @relation("RefundActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// §38/§49/8.4. `capabilities` mirrors packages/types' `PrinterCapabilities`,
// same shape and same "null means not yet declared" convention as
// Shop.capabilities. Printers are registered directly under a shop by
// shop staff (8.4) -- Phase 9's agent doesn't exist yet at this point in
// the plan; 9.1-9.6 attach real device identity and discovery on top of
// rows that already exist, rather than the agent being the only thing
// that can ever create one.
//
// 15.3/§16 expands the original 4 values with BUSY/PAUSED/MAINTENANCE/
// UNKNOWN -- additive only (Postgres `ALTER TYPE ... ADD VALUE`, never
// remove/rename), since ONLINE/OFFLINE/ERROR/DISABLED are already
// persisted data and cross the agent wire as literal strings. §16's own
// rule -- never assume a printer is available when its status is
// UNKNOWN -- is a Phase 18 allocation-engine concern, not encoded here;
// this migration only makes the value representable.
enum PrinterStatus {
  ONLINE
  OFFLINE
  ERROR
  DISABLED
  BUSY
  PAUSED
  MAINTENANCE
  UNKNOWN
}

model Printer {
  id                  String        @id @default(uuid())
  shopId              String        @map("shop_id")
  // §41/9.4. Nullable -- a printer registered by staff (8.4) before
  // any agent is ever installed has no agent yet. Set the first time
  // a heartbeat reports a printer this shop's agent knows about
  // (matched by name, then created if no existing row matches);
  // that's also what makes "this agent's printers" a well-defined set
  // for the missed-heartbeat sweep to mark OFFLINE.
  agentId             String?       @map("agent_id")
  name                String
  capabilities        Json?
  status              PrinterStatus @default(OFFLINE)
  // 15.3/§16's printer profile fields, all nullable/defaulted so every
  // printer row created before this migration is unaffected.
  // `model`/`location`/`connectionType` are plain free-text (the make/
  // model string, a physical/human location note, and a connection
  // description like "USB"/"Network" -- none of these are closed
  // enumerations worth a Postgres enum type for, and staff should be
  // able to describe them without a schema migration every time a new
  // connection type shows up).
  model               String?
  // Staff-set (never agent-reported -- 15.6 is explicit that the
  // agent must never overwrite this with null on a heartbeat that
  // simply doesn't carry a location).
  location            String?
  connectionType      String?       @map("connection_type")
  // §16/§64: what this printer can physically handle, as native
  // Postgres text arrays -- not JSON, to match `PaperSize`/`PaperType`
  // being plain string enums (packages/types) rather than an object
  // shape the way `capabilities` (a fixed {color,duplex,a4,a3} record)
  // is. A text array lets Phase 18's allocation engine filter with a
  // plain `hasSome`/`hasEvery` instead of unpacking JSON, and lets
  // Postgres enforce "this is a list of strings" structurally, which
  // a Json column can't. Defaults to an empty array (Prisma disallows
  // a nullable list field), meaning "nothing declared yet" the same
  // way `capabilities: null` already does for the boolean shape --
  // callers must treat an empty array as "unknown", not "supports
  // nothing", the same non-guessing rule 15.2 established for
  // `capabilities === null` on the auto-dispatch path.
  supportedSizes      String[]      @default([]) @map("supported_sizes")
  supportedPaperTypes String[]      @default([]) @map("supported_paper_types")
  maxJobPages         Int?          @map("max_job_pages")
  // Plain text, not a second enum alongside PrinterStatus. PrinterStatus
  // (specifically its new MAINTENANCE value) is the machine-readable
  // state allocation/dispatch decisions key off; `maintenanceStatus` is
  // staff-facing descriptive detail about *why* or *what* (e.g. "toner
  // replacement due", "servicing booked 2026-10-01") that nothing in
  // this codebase branches on. Making it a second closed enum would
  // either duplicate PrinterStatus's own values or invite the two
  // getting out of sync; free text avoids both.
  maintenanceStatus   String?       @map("maintenance_status")
  lastStatusAt        DateTime?     @map("last_status_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  agent     PrinterAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  printJobs PrintJob[]

  @@index([shopId])
  @@index([agentId])
  @@map("printers")
}

// §45/8.1. `shopId` is denormalized from the order/printer (both belong
// to the same shop by construction, enforced in the service layer, not
// a DB constraint) rather than joined every time -- 8.2's shop-scoped
// queries need it directly indexed, matching this sub-phase's own
// Done-when. `idempotencyToken` is the client-generated key from 8.8's
// "one key per Accept attempt" -- `@unique` is what makes double-tapping
// Accept create exactly one job (8.3's Done-when) a database guarantee,
// not just an application-level check. `claimedAt`/`osJobId` are 9.7's
// and 9.11's respectively; carried in this migration now because 8.1
// explicitly calls for them, even though nothing writes them until
// Phase 9.
model PrintJob {
  id               String         @id @default(uuid())
  orderId          String         @map("order_id")
  // 18.6: nullable as of this phase -- a job that allocatePrinter()
  // couldn't place anywhere (WAITING, blockedReason set) has no
  // printer yet. Every job that DOES have a printerId still means
  // exactly what it always has; nothing here changes for an allocated
  // job.
  printerId        String?        @map("printer_id")
  shopId           String         @map("shop_id")
  // 18.1: CREATED is the new default -- a freshly-exploded job starts
  // unallocated; dispatch (18.5) moves it to QUEUED (allocated) or
  // WAITING (blocked) via the job state machine, never by construction.
  status           PrintJobStatus @default(CREATED)
  idempotencyToken String         @unique @map("idempotency_token")
  claimedAt        DateTime?      @map("claimed_at")
  osJobId          String?        @map("os_job_id")
  // 15.4: the groundwork Phase 18's job-lifecycle split depends on.
  // orderItemId is nullable FOR NOW (deliberately -- tightening it to
  // NOT NULL is a later follow-up once every writer sets it; this
  // migration only adds the column and backfills it for existing
  // rows). blockedReason/pausedAt/supersededAt/attempt/priority are
  // all unused by any code path yet -- Phase 18 (blockedReason,
  // pausedAt, attempt/priority for the allocation engine) and this
  // same migration's own backfill (supersededAt, reproducing today's
  // SHOP_ORDER_INCLUDE `take: 1` as real data) are what write them.
  orderItemId      String?        @map("order_item_id")
  blockedReason    String?        @map("blocked_reason")
  supersededAt     DateTime?      @map("superseded_at")
  pausedAt         DateTime?      @map("paused_at")
  attempt          Int            @default(1)
  priority         Int            @default(0)
  // 18.9: manual (and, gated by its own toggle, automatic) assignment
  // of a job to a specific OPERATOR user. Nullable -- most jobs today
  // have no operator assigned at all; SetNull so removing a staff
  // member's account never takes job history down with it.
  operatorId       String?        @map("operator_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  order     Order      @relation(fields: [orderId], references: [id])
  // 18.23: explicit Restrict, matching what the database has always enforced. Phase 18
  // made printer_id nullable (a blocked job has no printer yet), and Prisma's default
  // for an OPTIONAL relation is SetNull -- so with no explicit onDelete the schema
  // silently claimed ON DELETE SET NULL while the DB kept RESTRICT, and the next
  // `prisma migrate dev` would have flipped it: deleting a printer would then erase
  // which printer printed every historical job. Restrict keeps job history intact.
  printer   Printer?   @relation(fields: [printerId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  operator  User?      @relation("PrintJobOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([orderId])
  @@index([printerId])
  @@index([orderItemId])
  @@index([operatorId])
  @@map("print_jobs")
}

// 15.4/§64. An order can require several, differently-configured
// production steps -- the PRD's own example is one order containing
// 100 A4 BW pages, 50 A4 color pages, and 10 laminated pages, each
// needing a different production path. OrderItem is the "what"; a
// PrintJob (Phase 18) is "how a specific printer/agent executed one
// item." printConfiguration/pricingSnapshot mirror Order's own fields
// exactly (same shape, same reasoning) but are per-item once an order
// has more than one. Every order has at least one item: this
// migration backfills exactly one synthetic PRINT item per
// pre-existing order from that order's own document_id +
// print_configuration; real multi-item orders start once Phase 17/18
// ship the machinery to create more than one, gated by
// shops.multiItemEnabled.
enum OrderItemType {
  PRINT
  LAMINATE
  BIND
}

model OrderItem {
  id                 String        @id @default(uuid())
  orderId            String        @map("order_id")
  documentId         String        @map("document_id")
  printConfiguration Json          @map("print_configuration")
  quantity           Int
  itemType           OrderItemType @map("item_type")
  required           Boolean       @default(true)
  pricingSnapshot    Json?         @map("pricing_snapshot")
  sequence           Int
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  document  Document   @relation(fields: [documentId], references: [id])
  printJobs PrintJob[]

  @@unique([orderId, sequence])
  @@index([orderId])
  @@index([documentId])
  @@map("order_items")
}

enum PrintJobStatus {
  // 18.1: additive only. CLAIMED/PRINTED keep their exact names -- both
  // strings cross the agent wire (15.6 froze that contract). CREATED:
  // a job exploded from an order item but not yet allocated to a
  // printer. WAITING: allocation was attempted and failed (18.6's
  // blockedReason explains why) -- a job re-enters WAITING, never
  // CREATED, on every subsequent failed allocation retry. PAUSED:
  // operator-paused (21.1). REASSIGNED: superseded by a manual
  // reassignment (18.7) -- the terminal status of the OLD job row, not
  // the new one, which starts its own lifecycle at CREATED/QUEUED.
  CREATED
  WAITING
  QUEUED
  CLAIMED
  PRINTING
  PRINTED
  PAUSED
  REASSIGNED
  FAILED
  UNKNOWN
  TIMEOUT
  CANCELLED
}

// §41/9.1. A device's own lifecycle (ACTIVE once paired, REVOKED if
// staff removes it) -- deliberately not the same enum as PrinterStatus
// (ONLINE/OFFLINE/ERROR/DISABLED). That tracks a *printer's* own
// heartbeat-derived connectivity (9.4 sets it from an active agent's
// heartbeat); this tracks whether the *agent's own credential* is
// still valid at all. `publicKey` is the Ed25519 public key the agent
// generated locally and never transmits the private half of (§41's
// own "prefer cryptographic device identity over shared passwords") --
// never a shared secret, per this sub-phase's own Done-when.
enum PrinterAgentStatus {
  ACTIVE
  REVOKED
}

model PrinterAgent {
  id         String             @id @default(uuid())
  deviceId   String             @unique @map("device_id")
  shopId     String             @map("shop_id")
  publicKey  String             @map("public_key")
  status     PrinterAgentStatus @default(ACTIVE)
  lastSeenAt DateTime?          @map("last_seen_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  printers Printer[]

  @@index([shopId])
  @@map("printer_agents")
}

// §41/9.2. `codeHash` (never the raw code, same "identified by its
// hash" convention as refresh_tokens/password_reset_tokens) is
// `@unique` so a redemption lookup is a single indexed query.
// `consumedAt` makes it single-use: 9.2's own Done-when ("a second
// redemption returns 410") is checked by the service, not a DB
// constraint, since "already consumed" and "expired" both need their
// own distinct 410 rather than a generic constraint-violation 500.
model AgentPairingCode {
  id         String    @id @default(uuid())
  codeHash   String    @unique @map("code_hash")
  shopId     String    @map("shop_id")
  createdBy  String    @map("created_by")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  shop    Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id])

  @@index([shopId])
  @@map("agent_pairing_codes")
}
