NODE_ENV=development
LOG_LEVEL=info

PORT=3000
# 3001 = customer-web; 8081 = shop-mobile's Expo web preview (native builds don't use CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081
# Rs 20.00 flat platform fee per order, applied on top of every shop's
# own pricing (S19). Set to 0 to disable.
PLATFORM_FEE_MINOR=2000

# Ports match infrastructure/docker/docker-compose.dev.yml, which remaps
# postgres/redis/minio off their defaults to avoid colliding with an
# unrelated Docker stack already running on this machine.
DATABASE_URL=postgresql://print_automated:print_automated_dev@localhost:5433/print_automated?connection_limit=20&pool_timeout=30
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=replace-with-32+-char-random-secret-in-dev
JWT_REFRESH_SECRET=replace-with-a-different-32+-char-secret
JWT_AGENT_SECRET=replace-with-yet-another-32+-char-secret

S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=print-automated-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

KMS_PROVIDER=local
KMS_LOCAL_MASTER_KEY=replace-with-32+-char-random-dev-master-key

PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-32+-char-random-webhook-secret
API_PUBLIC_BASE_URL=http://localhost:3000
PAYMENT_RECONCILIATION_GRACE_MINUTES=5
