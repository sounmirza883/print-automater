NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://print_automated:print_automated_dev@localhost:5433/print_automated?connection_limit=20&pool_timeout=30
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=print-automated-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

KMS_PROVIDER=local
KMS_LOCAL_MASTER_KEY=replace-with-32+-char-random-dev-master-key

CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

SMTP_HOST=localhost
SMTP_PORT=1025

EMAIL_TRANSPORT=mailhog
EMAIL_FROM_ADDRESS=no-reply@print-automated.dev

ORDER_PAYMENT_PENDING_TTL_MINUTES=30
PRINT_JOB_TIMEOUT_MINUTES=10
DOCUMENT_RETENTION_DAYS=30
