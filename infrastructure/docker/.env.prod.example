# Template for infrastructure/docker/.env.prod (git-ignored -- copy this
# file, rename it, fill in real values). Read alongside
# docker-compose.prod.yml and infrastructure/docker/README.md.
#
# Every required-with-no-default value below fails `docker compose up`
# outright (compose's own `${VAR:?message}` syntax) rather than
# silently booting with a dev-only placeholder -- deliberately, since
# this file backs a real production deployment, not the dev stack.

# --- Postgres ---
POSTGRES_USER=print_automated
POSTGRES_PASSWORD=replace-with-a-real-random-password
POSTGRES_DB=print_automated

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=replace-with-a-real-access-key
MINIO_ROOT_PASSWORD=replace-with-a-real-32+-char-secret-key
S3_REGION=us-east-1
S3_BUCKET=print-automated-documents

# --- API ---
# Comma-separated browser origins that call the API directly (customer-web).
# shop-web needs no entry: its BFF calls the API server-to-server.
CORS_ALLOWED_ORIGINS=https://app.print-automated.example
PLATFORM_FEE_MINOR=2000
JWT_ACCESS_SECRET=replace-with-a-real-32+-char-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32+-char-random-secret
JWT_AGENT_SECRET=replace-with-yet-another-32+-char-random-secret
KMS_LOCAL_MASTER_KEY=replace-with-a-real-32+-char-random-master-key
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-a-real-32+-char-random-webhook-secret
API_PUBLIC_BASE_URL=https://api.print-automated.example
API_HOST_PORT=3000

# --- Worker / email (14.5) ---
# TODO: point at a real SMTP relay before going live -- see the
# `mailhog` service's own TODO comment in docker-compose.prod.yml and
# infrastructure/docker/README.md's "SMTP relay" section. Left as
# MailHog (a mail *catcher*, not a real relay) so the stack is
# runnable end to end without a specific commercial provider chosen.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_TRANSPORT=smtp
EMAIL_FROM_ADDRESS=no-reply@print-automated.example

# --- Customer web ---
NEXT_PUBLIC_API_BASE_URL=https://api.print-automated.example
CUSTOMER_WEB_HOST_PORT=3001

# --- Shop web (back office, 23.17) ---
# Uses the same NEXT_PUBLIC_API_BASE_URL as above (baked in at build time).
SHOP_WEB_HOST_PORT=3002
# Published on loopback only (23.20): the host's TLS reverse proxy forwards to it.
# 0.0.0.0 exposes it on every interface -- only behind something that terminates TLS.
SHOP_WEB_BIND_ADDRESS=127.0.0.1

# --- Registry images (set by the deploy pipeline, 14.4; leave unset for
# a local `docker compose build`) ---
# API_IMAGE=ghcr.io/sounmirza883/print-automater/api:latest
# WORKER_IMAGE=ghcr.io/sounmirza883/print-automater/worker:latest
# CUSTOMER_WEB_IMAGE=ghcr.io/sounmirza883/print-automater/customer-web:latest
# SHOP_WEB_IMAGE=ghcr.io/sounmirza883/print-automater/shop-web:latest
