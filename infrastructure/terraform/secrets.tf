# §102: "production secrets live only in Secrets Manager." Every
# value here is randomly generated by Terraform itself, not read from
# a .tfvars file or hardcoded -- there is no real secret value
# anywhere in this repo's own source, matching 12.3's own git-history
# secret scan finding nothing to begin with.
resource "random_password" "jwt_access_secret" {
  length  = 64
  special = false
}

resource "random_password" "jwt_refresh_secret" {
  length  = 64
  special = false
}

resource "random_password" "jwt_agent_secret" {
  length  = 64
  special = false
}

resource "random_password" "mock_payment_webhook_secret" {
  length  = 64
  special = false
}

resource "random_password" "kms_local_master_key" {
  # §0.5/§62: KMS_PROVIDER=aws makes this unused by the app at runtime
  # (checkStorageEnv only requires it when KMS_PROVIDER=local) -- kept
  # populated anyway so a deploy can flip KMS_PROVIDER back to "local"
  # for a specific debugging session without a second apply.
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "app" {
  name = "${local.name_prefix}/app-secrets"
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({
    DATABASE_URL                = "postgresql://${var.db_username}:${random_password.db_password.result}@${aws_db_instance.main.address}:5432/${var.db_name}"
    REDIS_URL                   = "redis://${aws_elasticache_cluster.main.cache_nodes[0].address}:6379"
    JWT_ACCESS_SECRET           = random_password.jwt_access_secret.result
    JWT_REFRESH_SECRET          = random_password.jwt_refresh_secret.result
    JWT_AGENT_SECRET            = random_password.jwt_agent_secret.result
    MOCK_PAYMENT_WEBHOOK_SECRET = random_password.mock_payment_webhook_secret.result
    KMS_LOCAL_MASTER_KEY        = random_password.kms_local_master_key.result
    S3_ACCESS_KEY_ID            = aws_iam_access_key.s3_documents.id
    S3_SECRET_ACCESS_KEY        = aws_iam_access_key.s3_documents.secret
  })
}
