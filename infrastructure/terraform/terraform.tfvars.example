# Copy to terraform.tfvars (gitignored) and fill in. Every value below
# has a sensible default in variables.tf except domain_name, which has
# none on purpose -- ACM/SES both need DNS validation against a domain
# you actually control, so there is no safe default to ship.

domain_name = "staging.print-automated.example"

# aws_region          = "us-east-1"
# environment         = "staging"
# db_instance_class   = "db.t4g.micro"
# redis_node_type     = "cache.t4g.micro"
# image_tag           = "initial"
# alarm_sns_topic_arn = "arn:aws:sns:us-east-1:123456789012:print-automated-alerts"
