{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC, Ninja, vcpkg static)",
      "description": "Run from an x64 Native Tools / vcvars64 environment with VCPKG_ROOT set.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-x64",
      "displayName": "Windows x64 debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug" }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
