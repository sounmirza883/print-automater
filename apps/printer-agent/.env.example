NODE_ENV=development
LOG_LEVEL=info

API_BASE_URL=http://localhost:3000

# Path to the bundled/installed SumatraPDF executable (§9.9). Defaults
# to "SumatraPDF.exe" (relies on PATH) if unset.
SUMATRA_PATH=SumatraPDF.exe

# 11.6: how many days a resolved (PRINTED/FAILED) ledger row survives
# before the periodic sweep prunes it.
LEDGER_RETENTION_DAYS=30
