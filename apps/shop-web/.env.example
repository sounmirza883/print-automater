NODE_ENV=development
LOG_LEVEL=info

# The real API (services/api). shop-web's own route handlers call it
# server-side; the browser only ever talks to shop-web's origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# customer-web's own public origin (24.1 follow-on): used only to build the
# guest-ordering QR code URL (components/admin/shop-qr-code.tsx), read
# directly via process.env in that client component rather than through
# packages/config's webEnvSchema (which has no entry for it). Not required
# for the app to boot -- falls back to customer-web's dev port if unset.
# A production deploy should set this to customer-web's real public URL and
# pass it as a NEXT_PUBLIC_CUSTOMER_WEB_URL build arg the same way
# NEXT_PUBLIC_API_BASE_URL is passed in infrastructure/docker/shop-web.Dockerfile.
NEXT_PUBLIC_CUSTOMER_WEB_URL=http://localhost:3001
