NODE_ENV=development
LOG_LEVEL=info

# The API's public origin. Inlined into the browser bundle at build time: the QR
# guest-ordering pages call the API's /v1/public/* routes straight from the
# guest's browser (fix wave 1 -- there is no proxy on this app's server), so it
# must be reachable from browsers, and this app's own origin must be listed in
# the API's CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
