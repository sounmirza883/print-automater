{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "jest"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "ignoreDeprecations": "5.0",
    "incremental": true,
    "outDir": "dist",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "test",
    "e2e",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "next.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
