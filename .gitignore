# §13.3: the installer's own staged/downloaded/compiled artifacts --
# the packaging script (apps/printer-agent/scripts/package-installer.ps1)
# and the Inno Setup source script are committed; everything it
# produces (the downloaded SumatraPDF zip, the packaged agent .exe, the
# final installer .exe) is a build output, not source.
apps/printer-agent/installer/staging/
apps/printer-agent/installer/output/
.next/
.next-dev/
# Generated by Next, and it points at .next-dev under `next dev` but .next after a build
# (shop-web keeps the two apart), so tracking it would churn. shop-web typechecks without it.
apps/shop-web/next-env.d.ts
.turbo/
*.log
.env
.env.local
.env.*.local
# 14.3: real prod secrets for infrastructure/docker/docker-compose.prod.yml --
# infrastructure/docker/.env.prod.example is the committed template.
infrastructure/docker/.env.prod
.DS_Store
coverage/
.pnpm-store/
*.tsbuildinfo
test-results/
playwright-report/
blob-report/
playwright/.cache/
.expo/
expo-env.d.ts

# Terraform state holds every secret this config generates (DB
# password, JWT secrets, S3 access keys, §102) in plaintext -- never
# committed, matching every other real-secret exclusion above.
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars
*.auto.tfvars
crash.log
crash.*.log
